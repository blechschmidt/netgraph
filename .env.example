# Every variable docker-compose.yml reads, with the default it falls back to.
#
# Copy this to ``.env`` and edit -- compose reads that file automatically, so
# ``docker compose up web`` then needs no environment of its own. Nothing here is
# required: with no ``.env`` at all the defaults below are what you get.
#
#     cp .env.example .env
#
# ``.env`` is git-ignored on purpose: it names a path on your machine, which is
# not a fact about this repository.

# The inventory the services read. Any path a bind mount accepts -- absolute, or
# relative to this file. It is mounted read-only for the servers and read-write
# for the one-shot ``netviz`` service, always at /inventory.
NETVIZ_INVENTORY=./examples/home-lab

# Who the container runs as, so a file it writes is yours rather than root's.
# ``id -u`` and ``id -g``.
NETVIZ_UID=1000
NETVIZ_GID=1000

# The host address the two servers are published on. Loopback keeps the topology
# on this machine; 0.0.0.0 publishes it to everyone who can reach the host, which
# is a decision to make deliberately.
NETVIZ_BIND=127.0.0.1

# Host ports for the browser editor (``web``) and the live preview (``watch``).
# Only the host side: inside the container they stay on netviz's own defaults.
NETVIZ_WEB_PORT=8081
NETVIZ_WATCH_PORT=8080

# Which layer the live preview draws: l1 physical, l2 with VLANs, l3 subnets,
# overlay tunnels, rack elevation.
NETVIZ_LAYER=l1

# Icon theme for both servers: ``none`` for plain shapes, ``cisco`` for the
# built-in device pictures.
NETVIZ_ICONS=none

# YAML parser: ``auto`` uses libyaml when the PyYAML wheel carries it, ``python``
# forces the pure-Python one.
NETVIZ_YAML_LOADER=auto

# Set to 1 when the ``watch`` service reports no changes although files are being
# saved. Bind mounts on Docker Desktop (macOS, Windows) and over NFS do not
# deliver filesystem events; polling costs a little CPU and always works. Empty
# lets watchfiles decide from the platform.
WATCHFILES_FORCE_POLLING=
