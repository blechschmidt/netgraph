graph netgraph {
  graph [
    rankdir=TB,
    splines=true,
    overlap=false,
    nodesep=0.5,
    ranksep=0.7,
    fontname="Helvetica,Arial,sans-serif",
    fontsize=12,
  ];
  node [fontname="Helvetica,Arial,sans-serif", fontsize=10, style=filled, penwidth=1.2];
  edge [fontname="Helvetica,Arial,sans-serif", fontsize=8];

  "hosts/srv-app-01" [shape=cylinder, fillcolor="#eae2f5", color="#7c3aed", tooltip="srv-app-01 [server]\nnamespace: hosts\nApplication server, rack r2. Patched through position 7.\nlabels: env=prod, role=application, site=hq\nvlans: 10\ninterfaces (2):\n  lo  loopback  127.0.0.1/8\n  eno1  ethernet  10.10.0.11/24  3c:d9:2b:0a:00:11\nlinks (1):\n  eno1 — network/sw-core-01:GigabitEthernet1/0/7  (cable, copper, 1Gbps)  vlan 10", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>srv-app-01</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[server]</TD></TR>
      <TR><TD ALIGN="LEFT">eno1</TD><TD ALIGN="LEFT">10.10.0.11/24</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>
  >];
  "hosts/srv-db-01" [shape=cylinder, fillcolor="#eae2f5", color="#7c3aed", tooltip="srv-db-01 [server]\nnamespace: hosts\nDatabase server, rack r2. Patched through position 8.\nlabels: env=prod, role=database, site=hq\nvlans: 10\ninterfaces (2):\n  lo  loopback  127.0.0.1/8\n  eno1  ethernet  10.10.0.12/24  3c:d9:2b:0a:00:12\nlinks (1):\n  eno1 — network/sw-core-01:GigabitEthernet1/0/8  (cable, copper, 1Gbps)  vlan 10", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>srv-db-01</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[server]</TD></TR>
      <TR><TD ALIGN="LEFT">eno1</TD><TD ALIGN="LEFT">10.10.0.12/24</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>
  >];
  "network/rtr-edge-01" [shape=diamond, fillcolor="#dbe9f6", color="#2563eb", tooltip="rtr-edge-01 [router]\nnamespace: network\nEdge router for the machine room. It routes between the server VLAN and the outside world, and reaches the core switch over a routed (untagged) copper link in the same rack — the one run in this inventory that does not cross a patch panel.\nlabels: env=prod, role=edge, site=hq\ninterfaces (2):\n  lo0  loopback  192.0.2.1/32\n  ge-0/0/0  ethernet  10.0.0.1/30  00:05:86:0a:00:00\nlinks (1):\n  ge-0/0/0 — network/sw-core-01:GigabitEthernet1/0/1  (cable, copper, 1Gbps)", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>rtr-edge-01</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[router]</TD></TR>
      <TR><TD ALIGN="LEFT">lo0</TD><TD ALIGN="LEFT">192.0.2.1/32</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">ge-0/0/0</TD><TD ALIGN="LEFT">10.0.0.1/30</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>
  >];
  "network/sw-core-01" [shape=box3d, fillcolor="#dcf0dc", color="#16a34a", tooltip="sw-core-01 [switch]\nnamespace: network\nCore switch, rack r1. Its two server ports leave the rack through the patch panel above it: nothing is cabled from here to rack r2 directly, which is what a structured-cabling plant looks like.\nlabels: env=prod, role=core, site=hq\nvlans: 10\ninterfaces (5):\n  br0  bridge\n  Vlan10  vlan  10.10.0.2/24  vlan 10 (access)\n  GigabitEthernet1/0/1  ethernet  10.0.0.2/30  00:1b:0d:0a:00:01\n  GigabitEthernet1/0/7  ethernet  vlan 10 (access)  00:1b:0d:0a:00:07\n  GigabitEthernet1/0/8  ethernet  vlan 10 (access)  00:1b:0d:0a:00:08\nlinks (3):\n  GigabitEthernet1/0/1 — network/rtr-edge-01:ge-0/0/0  (cable, copper, 1Gbps)\n  GigabitEthernet1/0/7 — hosts/srv-app-01:eno1  (cable, copper, 1Gbps)  vlan 10\n  GigabitEthernet1/0/8 — hosts/srv-db-01:eno1  (cable, copper, 1Gbps)  vlan 10", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>sw-core-01</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[switch]</TD></TR>
      <TR><TD ALIGN="LEFT">Vlan10</TD><TD ALIGN="LEFT">10.10.0.2/24</TD><TD ALIGN="LEFT">vlan 10</TD></TR>
      <TR><TD ALIGN="LEFT">GigabitEthernet1/0/1</TD><TD ALIGN="LEFT">10.0.0.2/30</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">GigabitEthernet1/0/7</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
      <TR><TD ALIGN="LEFT">GigabitEthernet1/0/8</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
    </TABLE>
  >];

  "network/rtr-edge-01" -- "network/sw-core-01" [color="#4a4a4a", style=solid, penwidth=1.5, label="ge-0/0/0 -- GigabitEthernet1/0/1", tooltip="cable cables/cbl-rtr-sw\nnetwork/rtr-edge-01:ge-0/0/0 — network/sw-core-01:GigabitEthernet1/0/1\nmedium: copper, speed: 1Gbps, length: 1 m, label: C-001"];
  "network/sw-core-01" -- "hosts/srv-app-01" [color="#4a4a4a", style=solid, penwidth=1.5, label="GigabitEthernet1/0/7 -- eno1\nvlan 10", tooltip="cable cables/cbl-sw-pp07\nnetwork/sw-core-01:GigabitEthernet1/0/7 — hosts/srv-app-01:eno1\npatched run: 3 segments through 2 panels\nvia: panels/pp-r1-a front/7-rear/7, panels/pp-r2-a rear/7-front/7\nsegments: cables/cbl-sw-pp07, cables/cbl-tie-07, cables/cbl-pp-app07\nmedium: copper, speed: 1Gbps, length: 21 m, label: P-007A\nvlans: 10"];
  "network/sw-core-01" -- "hosts/srv-db-01" [color="#4a4a4a", style=solid, penwidth=1.5, label="GigabitEthernet1/0/8 -- eno1\nvlan 10", tooltip="cable cables/cbl-sw-pp08\nnetwork/sw-core-01:GigabitEthernet1/0/8 — hosts/srv-db-01:eno1\npatched run: 3 segments through 2 panels\nvia: panels/pp-r1-a front/8-rear/8, panels/pp-r2-a rear/8-front/8\nsegments: cables/cbl-sw-pp08, cables/cbl-tie-08, cables/cbl-pp-db08\nmedium: copper, speed: 1Gbps, length: 21 m, label: P-008A\nvlans: 10"];
}
