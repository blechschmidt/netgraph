graph netviz {
  graph [
    rankdir=TB,
    splines=true,
    overlap=false,
    nodesep=0.5,
    ranksep=0.7,
    fontname="Helvetica,Arial,sans-serif",
    fontsize=12,
    inputscale=72.0,
    _background="c 7 -#9ca3af p 4 8 242.76 8 540.62 824 540.62 824 242.76 c 7 -#9ca3af p 4 915 203 915 393 1403 393 1403 203 c 7 -#9ca3af p 4 613 8 613 164 805 164 805 8 c 7 -#9ca3af p 4 592 579.62 592 683.62 784 683.62 784 579.62",
    label="Arranged, layer 2",
    labelloc=t,
    fontsize=16,
  ];
  node [fontname="Helvetica,Arial,sans-serif", fontsize=10, style=filled, penwidth=1.2];
  edge [fontname="Helvetica,Arial,sans-serif", fontsize=8];

  "cluster-label:hosts" [shape=plaintext, style="", fillcolor="none", fontcolor="#4b5563", fontsize=11, margin=0, pos="416,551.62", label="hosts"];
  "cluster-label:routers" [shape=plaintext, style="", fillcolor="none", fontcolor="#4b5563", fontsize=11, margin=0, pos="1159,404", label="routers"];
  "cluster-label:switches" [shape=plaintext, style="", fillcolor="none", fontcolor="#4b5563", fontsize=11, margin=0, pos="709,175", label="switches"];
  "cluster-label:wireless" [shape=plaintext, style="", fillcolor="none", fontcolor="#4b5563", fontsize=11, margin=0, pos="688,694.62", label="wireless"];

  subgraph cluster_0 {
    label="hosts";
    tooltip="namespace hosts\n5 elements: 1 adapter, 3 computers, 1 server\nvlans: 10";
    style=rounded;
    color="#9ca3af";
    fontcolor="#4b5563";
    fontsize=11;
    labeljust=l;
    margin=12;
    "hosts/adp-usb-eth" [shape=ellipse, fillcolor="#fdf0e3", color="#ea580c", style="filled,dashed", pos="239,288", tooltip="adp-usb-eth [adapter]\nnamespace: hosts\nUSB 3.0 gigabit dongle. `upstream.attached_to` is what joins it to the laptop - there is deliberately no cable between the two (NG-X005).\nlabels: asset=A-0001, site=home\nvlans: 10\ninterfaces (1):\n  enx001122334455  ethernet  192.168.10.30/24, 2001:db8:10::30/64  00:11:22:33:44:55\nlinks (2):\n  enx001122334455 — switches/sw-home:port4  (cable, copper, 1Gbps)  vlan 10\n  usb0 — hosts/laptop  (attachment, copper, 5Gbps)", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
        <TR><TD COLSPAN="3" ALIGN="CENTER"><B>adp-usb-eth</B></TD></TR>
        <TR><TD COLSPAN="3" ALIGN="CENTER">[adapter]</TD></TR>
        <TR><TD ALIGN="LEFT">enx001122334455</TD><TD ALIGN="LEFT">192.168.10.30/24, 2001:db8:10::30/64</TD><TD ALIGN="LEFT"></TD></TR>
      </TABLE>
    >];
    "hosts/laptop" [shape=rectangle, fillcolor="#f5f5f5", color="#6b7280", pos="53,476.31", tooltip="laptop [computer]\nnamespace: hosts\nUltrabook without a built-in Ethernet port. It reaches the wired network through the USB dongle declared in hosts/adp-usb-eth.yaml, so it owns no cabled interface of its own.\nlabels: owner=sam, role=laptop, site=home\nvlans: 10\ninterfaces (2):\n  lo  loopback  127.0.0.1/8, ::1/128\n  wlp0s20f3  wifi  disabled  8c:8c:aa:30:01:01\nlinks (1):\n  hosts/adp-usb-eth:usb0  (attachment, copper, 5Gbps)", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
        <TR><TD COLSPAN="3" ALIGN="CENTER"><B>laptop</B></TD></TR>
        <TR><TD COLSPAN="3" ALIGN="CENTER">[computer]</TD></TR>
      </TABLE>
    >];
    "hosts/pc-desk" [shape=rectangle, fillcolor="#f5f5f5", color="#6b7280", pos="465,476.31", tooltip="pc-desk [computer]\nnamespace: hosts\nDesktop workstation in the study\nlabels: owner=sam, role=workstation, site=home\nvlans: 10\ninterfaces (3):\n  lo  loopback  127.0.0.1/8, ::1/128\n  eno1  ethernet  192.168.10.20/24, 2001:db8:10::20/64  3c:97:0e:20:01:01\n  wlp1s0  wifi  disabled  3c:97:0e:20:01:02\nlinks (1):\n  eno1 — switches/sw-home:port2  (cable, copper, 1Gbps)  vlan 10", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
        <TR><TD COLSPAN="3" ALIGN="CENTER"><B>pc-desk</B></TD></TR>
        <TR><TD COLSPAN="3" ALIGN="CENTER">[computer]</TD></TR>
        <TR><TD ALIGN="LEFT">eno1</TD><TD ALIGN="LEFT">192.168.10.20/24, 2001:db8:10::20/64</TD><TD ALIGN="LEFT"></TD></TR>
      </TABLE>
    >];
    "hosts/phone" [shape=rectangle, fillcolor="#f5f5f5", color="#6b7280", pos="223,476.31", tooltip="phone [computer]\nnamespace: hosts\nWireless-only client. It reaches the network through its association to ap-home, which is declared as a `medium: wireless` cable - the association is the link.\nlabels: owner=sam, role=mobile, site=home\ninterfaces (1):\n  en0  wifi  192.168.10.40/24, 2001:db8:10::40/64  f0:18:98:11:22:33\nlinks (1):\n  en0 — wireless/ap-home:wlan0  (cable, wireless)", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
        <TR><TD COLSPAN="3" ALIGN="CENTER"><B>phone</B></TD></TR>
        <TR><TD COLSPAN="3" ALIGN="CENTER">[computer]</TD></TR>
        <TR><TD ALIGN="LEFT">en0</TD><TD ALIGN="LEFT">192.168.10.40/24, 2001:db8:10::40/64</TD><TD ALIGN="LEFT"></TD></TR>
      </TABLE>
    >];
    "hosts/srv-nas" [shape=cylinder, fillcolor="#eae2f5", color="#7c3aed", pos="709,476.31", tooltip="srv-nas [server]\nnamespace: hosts\nBackup and media server\nlabels: env=prod, role=storage, site=home\nvlans: 10\ninterfaces (2):\n  lo  loopback  127.0.0.1/8, ::1/128\n  eth0  ethernet  192.168.10.10/24, 2001:db8:10::10/64  00:11:32:40:01:01\nlinks (1):\n  eth0 — switches/sw-home:port3  (cable, copper, 1Gbps)  vlan 10", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
        <TR><TD COLSPAN="3" ALIGN="CENTER"><B>srv-nas</B></TD></TR>
        <TR><TD COLSPAN="3" ALIGN="CENTER">[server]</TD></TR>
        <TR><TD ALIGN="LEFT">eth0</TD><TD ALIGN="LEFT">192.168.10.10/24, 2001:db8:10::10/64</TD><TD ALIGN="LEFT"></TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_1 {
    label="routers";
    tooltip="namespace routers\n1 element: 1 router\nvlans: 10";
    style=rounded;
    color="#9ca3af";
    fontcolor="#4b5563";
    fontsize=11;
    labeljust=l;
    margin=12;
    "routers/rtr-home" [shape=diamond, fillcolor="#dbe9f6", color="#2563eb", pos="1159,288", tooltip="rtr-home [router]\nnamespace: routers\nHome edge router. Terminates the ISP hand-off on wan0 and is the default gateway for the single home VLAN (10).\nlabels: env=prod, role=edge, site=home\nvlans: 10\ninterfaces (3):\n  lo0  loopback  192.0.2.1/32, 2001:db8::1/128\n  wan0  ethernet  203.0.113.2/30  00:1e:8c:00:10:01\n  lan0  ethernet  192.168.10.1/24, 2001:db8:10::1/64  vlan 10 (access)  00:1e:8c:00:10:02\nlinks (1):\n  lan0 — switches/sw-home:port1  (cable, copper, 1Gbps)  vlan 10", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
        <TR><TD COLSPAN="3" ALIGN="CENTER"><B>rtr-home</B></TD></TR>
        <TR><TD COLSPAN="3" ALIGN="CENTER">[router]</TD></TR>
        <TR><TD ALIGN="LEFT">lo0</TD><TD ALIGN="LEFT">192.0.2.1/32, 2001:db8::1/128</TD><TD ALIGN="LEFT"></TD></TR>
        <TR><TD ALIGN="LEFT">wan0</TD><TD ALIGN="LEFT">203.0.113.2/30</TD><TD ALIGN="LEFT"></TD></TR>
        <TR><TD ALIGN="LEFT">lan0</TD><TD ALIGN="LEFT">192.168.10.1/24, 2001:db8:10::1/64</TD><TD ALIGN="LEFT">vlan 10</TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_2 {
    label="switches";
    tooltip="namespace switches\n1 element: 1 switch\nvlans: 10,20";
    style=rounded;
    color="#9ca3af";
    fontcolor="#4b5563";
    fontsize=11;
    labeljust=l;
    margin=12;
    "switches/sw-home" [shape=box3d, fillcolor="#dcf0dc", color="#16a34a", pos="709,76", tooltip="sw-home [switch]\nnamespace: switches\nEight-port desktop switch in the hallway cabinet\nlabels: role=access, site=home\nvlans: 10,20\ninterfaces (7):\n  br0  bridge\n  Vlan10  vlan  192.168.10.2/24  vlan 10 (access)\n  port1  ethernet  vlan 10 (access)  00:22:07:aa:00:01\n  port2  ethernet  vlan 10 (access)  00:22:07:aa:00:02\n  port3  ethernet  vlan 10 (access)  00:22:07:aa:00:03\n  port4  ethernet  vlan 10 (access)  00:22:07:aa:00:04\n  port5  ethernet  vlan 10,20 (trunk)  00:22:07:aa:00:05\nlinks (5):\n  port1 — routers/rtr-home:lan0  (cable, copper, 1Gbps)  vlan 10\n  port2 — hosts/pc-desk:eno1  (cable, copper, 1Gbps)  vlan 10\n  port3 — hosts/srv-nas:eth0  (cable, copper, 1Gbps)  vlan 10\n  port4 — hosts/adp-usb-eth:enx001122334455  (cable, copper, 1Gbps)  vlan 10\n  port5 — wireless/ap-home:eth0  (cable, copper, 1Gbps)  vlan 10,20", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
        <TR><TD COLSPAN="3" ALIGN="CENTER"><B>sw-home</B></TD></TR>
        <TR><TD COLSPAN="3" ALIGN="CENTER">[switch]</TD></TR>
        <TR><TD ALIGN="LEFT">Vlan10</TD><TD ALIGN="LEFT">192.168.10.2/24</TD><TD ALIGN="LEFT">vlan 10</TD></TR>
        <TR><TD ALIGN="LEFT">port1</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
        <TR><TD ALIGN="LEFT">port2</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
        <TR><TD ALIGN="LEFT">port3</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
        <TR><TD ALIGN="LEFT">port4</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
        <TR><TD ALIGN="LEFT">port5</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10,20</TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_3 {
    label="wireless";
    tooltip="namespace wireless\n1 element: 1 switch\nvlans: 10,20";
    style=rounded;
    color="#9ca3af";
    fontcolor="#4b5563";
    fontsize=11;
    labeljust=l;
    margin=12;
    "wireless/ap-home" [shape=box3d, fillcolor="#dcf0dc", color="#16a34a", pos="688,621.62", tooltip="ap-home [switch]\nnamespace: wireless\nCeiling access point in the hallway, powered over the uplink. It is a switch: the radio is a bridge port like any other, and the two SSIDs are what it bridges the air into.\nlabels: role=wireless, site=home\nvlans: 10,20\ninterfaces (4):\n  br0  bridge\n  Vlan10  vlan  192.168.10.3/24  vlan 10 (access)\n  eth0  ethernet  vlan 10,20 (trunk)  78:8a:20:aa:00:01\n  wlan0  wifi  78:8a:20:aa:00:10\nlinks (2):\n  eth0 — switches/sw-home:port5  (cable, copper, 1Gbps)  vlan 10,20\n  wlan0 — hosts/phone:en0  (cable, wireless)", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
        <TR><TD COLSPAN="3" ALIGN="CENTER"><B>ap-home</B></TD></TR>
        <TR><TD COLSPAN="3" ALIGN="CENTER">[switch]</TD></TR>
        <TR><TD ALIGN="LEFT">Vlan10</TD><TD ALIGN="LEFT">192.168.10.3/24</TD><TD ALIGN="LEFT">vlan 10</TD></TR>
        <TR><TD ALIGN="LEFT">eth0</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10,20</TD></TR>
      </TABLE>
    >];
  }

  "routers/rtr-home" -- "switches/sw-home" [color="#4a4a4a", style=solid, penwidth=1.5, pos="1131,274.81 999.67,212.94 868.33,151.06 737,89.19", label="lan0 -- port1\nvlan 10", tooltip="cable cables/cbl-rtr-sw\nrouters/rtr-home:lan0 — switches/sw-home:port1\nmedium: copper, speed: 1Gbps, length: 0.5 m, label: H-001\nvlans: 10"];
  "hosts/pc-desk" -- "switches/sw-home" [color="#4a4a4a", style=solid, penwidth=1.5, pos="476.58,457.31 550.19,336.54 623.81,215.77 697.42,95", label="eno1 -- port2\nvlan 10", tooltip="cable cables/cbl-sw-desk\nhosts/pc-desk:eno1 — switches/sw-home:port2\nmedium: copper, speed: 1Gbps, length: 8 m, label: H-002\nvlans: 10"];
  "hosts/srv-nas" -- "switches/sw-home" [color="#4a4a4a", style=solid, penwidth=1.5, pos="709,457.31 709,336.54 709,215.77 709,95", label="eth0 -- port3\nvlan 10", tooltip="cable cables/cbl-sw-nas\nhosts/srv-nas:eth0 — switches/sw-home:port3\nmedium: copper, speed: 1Gbps, length: 0.5 m, label: H-003\nvlans: 10"];
  "hosts/adp-usb-eth" -- "switches/sw-home" [color="#4a4a4a", style=solid, penwidth=1.5, pos="267,275.37 405,213.12 543,150.88 681,88.63", label="enx001122334455 -- port4\nvlan 10", tooltip="cable cables/cbl-sw-dongle\nhosts/adp-usb-eth:enx001122334455 — switches/sw-home:port4\nmedium: copper, speed: 1Gbps, length: 10 m, label: H-004\nvlans: 10"];
  "wireless/ap-home" -- "switches/sw-home" [color="#4a4a4a", style=solid, penwidth=1.5, pos="688.73,602.62 695.24,433.41 701.76,264.21 708.27,95", label="eth0 -- port5\nvlan 10,20", tooltip="cable cables/cbl-sw-ap\nwireless/ap-home:eth0 — switches/sw-home:port5\nmedium: copper, speed: 1Gbps, length: 6 m, label: H-005\nvlans: 10,20"];
  "wireless/ap-home" -- "hosts/phone" [color="#2563eb", style=dashed, pos="660,612.87 523.67,570.27 387.33,527.66 251,485.06", label="wlan0 -- en0\nhome @ 36/5GHz", tooltip="cable cables/wl-ap-phone\nwireless/ap-home:wlan0 — hosts/phone:en0\nmedium: wireless, wireless: home @ 36/5GHz"];
  "hosts/laptop" -- "hosts/adp-usb-eth" [color="#9ca3af", style=dotted, penwidth=2.0, pos="71.77,457.31 121.26,407.21 170.74,357.1 220.23,307", label="usb0\nusb", tooltip="attachment hosts/adp-usb-eth#upstream\nhosts/laptop — hosts/adp-usb-eth:usb0\nmedium: copper, speed: 5Gbps, label: usb"];
}
