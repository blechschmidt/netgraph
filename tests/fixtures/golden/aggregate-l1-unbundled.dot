      <TR><TD ALIGN="LEFT">GigabitEthernet1/0/3</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
      <TR><TD ALIGN="LEFT">GigabitEthernet1/0/4</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
      <TR><TD ALIGN="LEFT">GigabitEthernet1/0/9</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
      <TR><TD ALIGN="LEFT">GigabitEthernet1/0/10</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">(+1 more interface)</TD></TR>
    </TABLE>
  >];
  "sites/west/sw-west-01" [shape=box3d, fillcolor="#dcf0dc", color="#16a34a", tooltip="sw-west-01 [switch]\nnamespace: sites/west\nWest / rack 1\nlabels: site=west\nvlans: 10\ninterfaces (4):\n  br0  bridge\n  Vlan10  vlan  10.20.0.4/24  vlan 10 (access)\n  GigabitEthernet1/0/20  ethernet  vlan 10 (access)\n  GigabitEthernet1/0/21  ethernet  vlan 10 (access)\nlinks (2):\n  GigabitEthernet1/0/20 — sites/east/sw-east-01:GigabitEthernet1/0/20  (cable, copper, 1Gbps)  vlan 10\n  GigabitEthernet1/0/21 — sites/east/sw-east-02:GigabitEthernet1/0/21  (cable, copper, 1Gbps)  vlan 10", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>sw-west-01</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[switch]</TD></TR>
      <TR><TD ALIGN="LEFT">Vlan10</TD><TD ALIGN="LEFT">10.20.0.4/24</TD><TD ALIGN="LEFT">vlan 10</TD></TR>
      <TR><TD ALIGN="LEFT">GigabitEthernet1/0/20</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
      <TR><TD ALIGN="LEFT">GigabitEthernet1/0/21</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
    </TABLE>
  >];

  "sites/east/sw-east-01" -- "sites/east/sw-east-02" [color="#4a4a4a", style=solid, penwidth=1.5, label="GigabitEthernet1/0/1 -- GigabitEthernet1/0/1\nCBL-LAG-1\n1Gbps\nvlan 10", tooltip="cable cables/cbl-lag-1\nsites/east/sw-east-01:GigabitEthernet1/0/1 — sites/east/sw-east-02:GigabitEthernet1/0/1\nmedium: copper, speed: 1Gbps, length: 2 m, label: CBL-LAG-1\nvlans: 10"];
  "sites/east/sw-east-01" -- "sites/east/sw-east-02" [color="#4a4a4a", style=solid, penwidth=1.5, label="GigabitEthernet1/0/2 -- GigabitEthernet1/0/2\nCBL-LAG-2\n1Gbps\nvlan 10", tooltip="cable cables/cbl-lag-2\nsites/east/sw-east-01:GigabitEthernet1/0/2 — sites/east/sw-east-02:GigabitEthernet1/0/2\nmedium: copper, speed: 1Gbps, length: 2 m, label: CBL-LAG-2\nvlans: 10"];
  "sites/east/sw-east-01" -- "sites/east/sw-east-02" [color="#4a4a4a", style=solid, penwidth=1.5, label="GigabitEthernet1/0/3 -- GigabitEthernet1/0/3\nCBL-LAG-3\n1Gbps\nvlan 10", tooltip="cable cables/cbl-lag-3\nsites/east/sw-east-01:GigabitEthernet1/0/3 — sites/east/sw-east-02:GigabitEthernet1/0/3\nmedium: copper, speed: 1Gbps, length: 2 m, label: CBL-LAG-3\nvlans: 10"];
  "sites/east/sw-east-01" -- "sites/east/sw-east-02" [color="#4a4a4a", style=solid, penwidth=1.5, label="GigabitEthernet1/0/4 -- GigabitEthernet1/0/4\nCBL-LAG-4\n1Gbps\nvlan 10", tooltip="cable cables/cbl-lag-4\nsites/east/sw-east-01:GigabitEthernet1/0/4 — sites/east/sw-east-02:GigabitEthernet1/0/4\nmedium: copper, speed: 1Gbps, length: 2 m, label: CBL-LAG-4\nvlans: 10"];
  "sites/east/sw-east-01" -- "sites/east/sw-east-02" [color="#4a4a4a", style=solid, penwidth=1.5, label="GigabitEthernet1/0/9 -- GigabitEthernet1/0/9\nCBL-SPARE-1\n1Gbps\nvlan 10", tooltip="cable cables/cbl-spare-1\nsites/east/sw-east-01:GigabitEthernet1/0/9 — sites/east/sw-east-02:GigabitEthernet1/0/9\nmedium: copper, speed: 1Gbps, length: 2 m, label: CBL-SPARE-1\nvlans: 10"];
  "sites/east/sw-east-01" -- "sites/east/sw-east-02" [color="#4a4a4a", style=solid, penwidth=1.5, label="GigabitEthernet1/0/10 -- GigabitEthernet1/0/10\nCBL-SPARE-2\n1Gbps\nvlan 10", tooltip="cable cables/cbl-spare-2\nsites/east/sw-east-01:GigabitEthernet1/0/10 — sites/east/sw-east-02:GigabitEthernet1/0/10\nmedium: copper, speed: 1Gbps, length: 2 m, label: CBL-SPARE-2\nvlans: 10"];
  "sites/east/pc-east-01" -- "sites/east/sw-east-01" [color="#4a4a4a", style=solid, penwidth=1.5, label="eno1 -- GigabitEthernet1/0/11\nCBL-DESK-1\n1Gbps\nvlan 10", tooltip="cable cables/cbl-desk-1\nsites/east/pc-east-01:eno1 — sites/east/sw-east-01:GigabitEthernet1/0/11\nmedium: copper, speed: 1Gbps, length: 2 m, label: CBL-DESK-1\nvlans: 10"];
  "sites/east/sw-east-01" -- "sites/west/sw-west-01" [color="#4a4a4a", style=solid, penwidth=1.5, label="GigabitEthernet1/0/20 -- GigabitEthernet1/0/20\nCBL-EAST-WEST\n1Gbps\nvlan 10", tooltip="cable cables/cbl-east-west\nsites/east/sw-east-01:GigabitEthernet1/0/20 — sites/west/sw-west-01:GigabitEthernet1/0/20\nmedium: copper, speed: 1Gbps, length: 2 m, label: CBL-EAST-WEST\nvlans: 10"];
  "sites/east/sw-east-02" -- "sites/west/sw-west-01" [color="#4a4a4a", style=solid, penwidth=1.5, label="GigabitEthernet1/0/21 -- GigabitEthernet1/0/21\nCBL-EAST-WEST-2\n1Gbps\nvlan 10", tooltip="cable cables/cbl-east-west-2\nsites/east/sw-east-02:GigabitEthernet1/0/21 — sites/west/sw-west-01:GigabitEthernet1/0/21\nmedium: copper, speed: 1Gbps, length: 2 m, label: CBL-EAST-WEST-2\nvlans: 10"];
}
