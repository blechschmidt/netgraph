graph netgraph {
  graph [
    rankdir=TB,
    splines=true,
    overlap=false,
    nodesep=0.5,
    ranksep=0.7,
    fontname="Helvetica,Arial,sans-serif",
    fontsize=12,
    label="Nothing bundled",
    labelloc=t,
    fontsize=16,
  ];
  node [fontname="Helvetica,Arial,sans-serif", fontsize=10, style=filled, penwidth=1.2];
  edge [fontname="Helvetica,Arial,sans-serif", fontsize=8];

  "sites/east/pc-east-01" [shape=rectangle, fillcolor="#f5f5f5", color="#6b7280", tooltip="pc-east-01 [computer]\nnamespace: sites/east\nA desk in the east site\nlabels: site=east\nvlans: 10\ninterfaces (1):\n  eno1  ethernet  10.20.0.11/24\nlinks (1):\n  eno1 — sites/east/sw-east-01:GigabitEthernet1/0/11  (cable, copper, 1Gbps)  vlan 10", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>pc-east-01</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[computer]</TD></TR>
      <TR><TD ALIGN="LEFT">eno1</TD><TD ALIGN="LEFT">10.20.0.11/24</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>
  >];
  "sites/east/sw-east-01" [shape=box3d, fillcolor="#dcf0dc", color="#16a34a", tooltip="sw-east-01 [switch]\nnamespace: sites/east\nEast / rack 1\nlabels: site=east\nvlans: 10\ninterfaces (11):\n  br0  bridge\n  Vlan10  vlan  10.20.0.2/24  vlan 10 (access)\n  Port-channel1  lag  vlan 10 (access)\n  GigabitEthernet1/0/1  ethernet  vlan 10 (access)\n  GigabitEthernet1/0/2  ethernet  vlan 10 (access)\n  GigabitEthernet1/0/3  ethernet  vlan 10 (access)\n  GigabitEthernet1/0/4  ethernet  vlan 10 (access)\n  GigabitEthernet1/0/9  ethernet  vlan 10 (access)\n  (+3 more)\nlinks (8):\n  GigabitEthernet1/0/1 — sites/east/sw-east-02:GigabitEthernet1/0/1  (cable, copper, 1Gbps)  vlan 10\n  GigabitEthernet1/0/2 — sites/east/sw-east-02:GigabitEthernet1/0/2  (cable, copper, 1Gbps)  vlan 10\n  GigabitEthernet1/0/3 — sites/east/sw-east-02:GigabitEthernet1/0/3  (cable, copper, 1Gbps)  vlan 10\n  GigabitEthernet1/0/4 — sites/east/sw-east-02:GigabitEthernet1/0/4  (cable, copper, 1Gbps)  vlan 10\n  GigabitEthernet1/0/9 — sites/east/sw-east-02:GigabitEthernet1/0/9  (cable, copper, 1Gbps)  vlan 10\n  GigabitEthernet1/0/10 — sites/east/sw-east-02:GigabitEthernet1/0/10  (cable, copper, 1Gbps)  vlan 10\n  GigabitEthernet1/0/11 — sites/east/pc-east-01:eno1  (cable, copper, 1Gbps)  vlan 10\n  GigabitEthernet1/0/20 — s… (+75 more characters)", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>sw-east-01</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[switch]</TD></TR>
      <TR><TD ALIGN="LEFT">Vlan10</TD><TD ALIGN="LEFT">10.20.0.2/24</TD><TD ALIGN="LEFT">vlan 10</TD></TR>
      <TR><TD ALIGN="LEFT">Port-channel1</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
      <TR><TD ALIGN="LEFT">GigabitEthernet1/0/1</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
      <TR><TD ALIGN="LEFT">GigabitEthernet1/0/2</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
      <TR><TD ALIGN="LEFT">GigabitEthernet1/0/3</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
      <TR><TD ALIGN="LEFT">GigabitEthernet1/0/4</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
      <TR><TD ALIGN="LEFT">GigabitEthernet1/0/9</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
      <TR><TD ALIGN="LEFT">GigabitEthernet1/0/10</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">(+2 more interfaces)</TD></TR>
    </TABLE>
  >];
  "sites/east/sw-east-02" [shape=box3d, fillcolor="#dcf0dc", color="#16a34a", tooltip="sw-east-02 [switch]\nnamespace: sites/east\nEast / rack 2\nlabels: site=east\nvlans: 10\ninterfaces (10):\n  br0  bridge\n  Vlan10  vlan  10.20.0.3/24  vlan 10 (access)\n  Port-channel1  lag  vlan 10 (access)\n  GigabitEthernet1/0/1  ethernet  vlan 10 (access)\n  GigabitEthernet1/0/2  ethernet  vlan 10 (access)\n  GigabitEthernet1/0/3  ethernet  vlan 10 (access)\n  GigabitEthernet1/0/4  ethernet  vlan 10 (access)\n  GigabitEthernet1/0/9  ethernet  vlan 10 (access)\n  (+2 more)\nlinks (7):\n  GigabitEthernet1/0/1 — sites/east/sw-east-01:GigabitEthernet1/0/1  (cable, copper, 1Gbps)  vlan 10\n  GigabitEthernet1/0/2 — sites/east/sw-east-01:GigabitEthernet1/0/2  (cable, copper, 1Gbps)  vlan 10\n  GigabitEthernet1/0/3 — sites/east/sw-east-01:GigabitEthernet1/0/3  (cable, copper, 1Gbps)  vlan 10\n  GigabitEthernet1/0/4 — sites/east/sw-east-01:GigabitEthernet1/0/4  (cable, copper, 1Gbps)  vlan 10\n  GigabitEthernet1/0/9 — sites/east/sw-east-01:GigabitEthernet1/0/9  (cable, copper, 1Gbps)  vlan 10\n  GigabitEthernet1/0/10 — sites/east/sw-east-01:GigabitEthernet1/0/10  (cable, copper, 1Gbps)  vlan 10\n  GigabitEthernet1/0/21 — sites/west/sw-west-01:GigabitEthernet1/0/21  (cable, copper, 1Gbps)  vlan 10", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>sw-east-02</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[switch]</TD></TR>
      <TR><TD ALIGN="LEFT">Vlan10</TD><TD ALIGN="LEFT">10.20.0.3/24</TD><TD ALIGN="LEFT">vlan 10</TD></TR>
      <TR><TD ALIGN="LEFT">Port-channel1</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
      <TR><TD ALIGN="LEFT">GigabitEthernet1/0/1</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
