graph netgraph {
  graph [
    rankdir=TB,
    splines=true,
    overlap=false,
    nodesep=0.5,
    ranksep=0.7,
    fontname="Helvetica,Arial,sans-serif",
    fontsize=12,
    label="Patch room, cabling",
    labelloc=t,
    fontsize=16,
  ];
  node [fontname="Helvetica,Arial,sans-serif", fontsize=10, style=filled, penwidth=1.2];
  edge [fontname="Helvetica,Arial,sans-serif", fontsize=8];

  "hosts/srv-app-01" [shape=cylinder, fillcolor="#eae2f5", color="#7c3aed", tooltip="srv-app-01 [server]\nnamespace: hosts\nApplication server, rack r2. Patched through position 7.\nlabels: env=prod, role=application, site=hq\ninterfaces (2):\n  lo  loopback  127.0.0.1/8\n  eno1  ethernet  10.10.0.11/24  3c:d9:2b:0a:00:11\nlinks (1):\n  eno1 — panels/pp-r2-a:front/7  (cable, copper, 1Gbps)", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>srv-app-01</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[server]</TD></TR>
      <TR><TD ALIGN="LEFT">eno1</TD><TD ALIGN="LEFT">10.10.0.11/24</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>
  >];
  "hosts/srv-db-01" [shape=cylinder, fillcolor="#eae2f5", color="#7c3aed", tooltip="srv-db-01 [server]\nnamespace: hosts\nDatabase server, rack r2. Patched through position 8.\nlabels: env=prod, role=database, site=hq\ninterfaces (2):\n  lo  loopback  127.0.0.1/8\n  eno1  ethernet  10.10.0.12/24  3c:d9:2b:0a:00:12\nlinks (1):\n  eno1 — panels/pp-r2-a:front/8  (cable, copper, 1Gbps)", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>srv-db-01</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[server]</TD></TR>
      <TR><TD ALIGN="LEFT">eno1</TD><TD ALIGN="LEFT">10.10.0.12/24</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>
  >];
  "network/rtr-edge-01" [shape=diamond, fillcolor="#dbe9f6", color="#2563eb", tooltip="rtr-edge-01 [router]\nnamespace: network\nEdge router for the machine room. It routes between the server VLAN and the outside world, and reaches the core switch over a routed (untagged) copper link in the same rack — the one run in this inventory that does not cross a patch panel.\nlabels: env=prod, role=edge, site=hq\ninterfaces (2):\n  lo0  loopback  192.0.2.1/32\n  ge-0/0/0  ethernet  10.0.0.1/30  00:05:86:0a:00:00\nlinks (1):\n  ge-0/0/0 — network/sw-core-01:GigabitEthernet1/0/1  (cable, copper, 1Gbps)", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>rtr-edge-01</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[router]</TD></TR>
      <TR><TD ALIGN="LEFT">lo0</TD><TD ALIGN="LEFT">192.0.2.1/32</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">ge-0/0/0</TD><TD ALIGN="LEFT">10.0.0.1/30</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>
  >];
  "network/sw-core-01" [shape=box3d, fillcolor="#dcf0dc", color="#16a34a", tooltip="sw-core-01 [switch]\nnamespace: network\nCore switch, rack r1. Its two server ports leave the rack through the patch panel above it: nothing is cabled from here to rack r2 directly, which is what a structured-cabling plant looks like.\nlabels: env=prod, role=core, site=hq\nvlans: 10\ninterfaces (5):\n  br0  bridge\n  Vlan10  vlan  10.10.0.2/24  vlan 10 (access)\n  GigabitEthernet1/0/1  ethernet  10.0.0.2/30  00:1b:0d:0a:00:01\n  GigabitEthernet1/0/7  ethernet  vlan 10 (access)  00:1b:0d:0a:00:07\n  GigabitEthernet1/0/8  ethernet  vlan 10 (access)  00:1b:0d:0a:00:08\nlinks (3):\n  GigabitEthernet1/0/1 — network/rtr-edge-01:ge-0/0/0  (cable, copper, 1Gbps)\n  GigabitEthernet1/0/7 — panels/pp-r1-a:front/7  (cable, copper, 1Gbps)  vlan 10\n  GigabitEthernet1/0/8 — panels/pp-r1-a:front/8  (cable, copper, 1Gbps)  vlan 10", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>sw-core-01</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[switch]</TD></TR>
      <TR><TD ALIGN="LEFT">Vlan10</TD><TD ALIGN="LEFT">10.10.0.2/24</TD><TD ALIGN="LEFT">vlan 10</TD></TR>
      <TR><TD ALIGN="LEFT">GigabitEthernet1/0/1</TD><TD ALIGN="LEFT">10.0.0.2/30</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">GigabitEthernet1/0/7</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
      <TR><TD ALIGN="LEFT">GigabitEthernet1/0/8</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
    </TABLE>
  >];
  "panels/pp-r1-a" [shape=box, fillcolor="#eef2f7", color="#64748b", tooltip="pp-r1-a [patchpanel]\nnamespace: panels\n24-position keystone panel at the top of rack r1. Its front positions face the switch below it; its rear positions terminate the permanent cabling to rack r2. Positions 1 to 6 are spare, which is what a panel is for.\nlabels: role=cross-connect, site=hq\nvlans: 10\ninterfaces (48):\n  front/1  ethernet\n  front/2  ethernet\n  front/3  ethernet\n  front/4  ethernet\n  front/5  ethernet\n  front/6  ethernet\n  front/7  ethernet\n  front/8  ethernet\n  (+40 more)\nlinks (4):\n  front/7 — network/sw-core-01:GigabitEthernet1/0/7  (cable, copper, 1Gbps)  vlan 10\n  rear/7 — panels/pp-r2-a:rear/7  (cable, copper, 1Gbps)\n  front/8 — network/sw-core-01:GigabitEthernet1/0/8  (cable, copper, 1Gbps)  vlan 10\n  rear/8 — panels/pp-r2-a:rear/8  (cable, copper, 1Gbps)", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>pp-r1-a</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[patchpanel]</TD></TR>
    </TABLE>
  >];
  "panels/pp-r2-a" [shape=box, fillcolor="#eef2f7", color="#64748b", tooltip="pp-r2-a [patchpanel]\nnamespace: panels\nThe other end of the same permanent cabling, at the top of rack r2. Each of its rear positions is tied to the matching position of pp-r1-a; the front positions are what the servers below are patched into.\nlabels: role=cross-connect, site=hq\ninterfaces (48):\n  front/1  ethernet\n  front/2  ethernet\n  front/3  ethernet\n  front/4  ethernet\n  front/5  ethernet\n  front/6  ethernet\n  front/7  ethernet\n  front/8  ethernet\n  (+40 more)\nlinks (4):\n  rear/7 — panels/pp-r1-a:rear/7  (cable, copper, 1Gbps)\n  front/7 — hosts/srv-app-01:eno1  (cable, copper, 1Gbps)\n  rear/8 — panels/pp-r1-a:rear/8  (cable, copper, 1Gbps)\n  front/8 — hosts/srv-db-01:eno1  (cable, copper, 1Gbps)", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>pp-r2-a</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[patchpanel]</TD></TR>
    </TABLE>
  >];

  "network/rtr-edge-01" -- "network/sw-core-01" [color="#4a4a4a", style=solid, penwidth=1.5, label="ge-0/0/0 -- GigabitEthernet1/0/1\nC-001\n1Gbps", tooltip="cable cables/cbl-rtr-sw\nnetwork/rtr-edge-01:ge-0/0/0 — network/sw-core-01:GigabitEthernet1/0/1\nmedium: copper, speed: 1Gbps, length: 1 m, label: C-001"];
  "panels/pp-r1-a" -- "network/sw-core-01" [color="#4a4a4a", style=solid, penwidth=1.5, label="front/7 -- GigabitEthernet1/0/7\nP-007A\n1Gbps\nvlan 10", tooltip="cable cables/cbl-sw-pp07\npanels/pp-r1-a:front/7 — network/sw-core-01:GigabitEthernet1/0/7\nmedium: copper, speed: 1Gbps, length: 1 m, label: P-007A\nvlans: 10"];
  "panels/pp-r1-a" -- "panels/pp-r2-a" [color="#4a4a4a", style=solid, penwidth=1.5, label="rear/7 -- rear/7\nT-007\n1Gbps", tooltip="cable cables/cbl-tie-07\npanels/pp-r1-a:rear/7 — panels/pp-r2-a:rear/7\nmedium: copper, speed: 1Gbps, length: 18 m, label: T-007"];
  "panels/pp-r2-a" -- "hosts/srv-app-01" [color="#4a4a4a", style=solid, penwidth=1.5, label="front/7 -- eno1\nP-007B\n1Gbps", tooltip="cable cables/cbl-pp-app07\npanels/pp-r2-a:front/7 — hosts/srv-app-01:eno1\nmedium: copper, speed: 1Gbps, length: 2 m, label: P-007B"];
  "panels/pp-r1-a" -- "network/sw-core-01" [color="#4a4a4a", style=solid, penwidth=1.5, label="front/8 -- GigabitEthernet1/0/8\nP-008A\n1Gbps\nvlan 10", tooltip="cable cables/cbl-sw-pp08\npanels/pp-r1-a:front/8 — network/sw-core-01:GigabitEthernet1/0/8\nmedium: copper, speed: 1Gbps, length: 1 m, label: P-008A\nvlans: 10"];
  "panels/pp-r1-a" -- "panels/pp-r2-a" [color="#4a4a4a", style=solid, penwidth=1.5, label="rear/8 -- rear/8\nT-008\n1Gbps", tooltip="cable cables/cbl-tie-08\npanels/pp-r1-a:rear/8 — panels/pp-r2-a:rear/8\nmedium: copper, speed: 1Gbps, length: 18 m, label: T-008"];
  "panels/pp-r2-a" -- "hosts/srv-db-01" [color="#4a4a4a", style=solid, penwidth=1.5, label="front/8 -- eno1\nP-008B\n1Gbps", tooltip="cable cables/cbl-pp-db08\npanels/pp-r2-a:front/8 — hosts/srv-db-01:eno1\nmedium: copper, speed: 1Gbps, length: 2 m, label: P-008B"];
}
