graph netviz {
  graph [
    rankdir=TB,
    splines=true,
    overlap=false,
    nodesep=0.5,
    ranksep=0.7,
    fontname="Helvetica,Arial,sans-serif",
    fontsize=12,
    label="Styled, themed",
    labelloc=t,
    fontsize=16,
  ];
  node [fontname="Helvetica,Arial,sans-serif", fontsize=10, style=filled, penwidth=1.2];
  edge [fontname="Helvetica,Arial,sans-serif", fontsize=8];

  "sites/branch/rtr-edge" [shape=diamond, fillcolor="#dbe9f6", color="#2563eb", style="filled,dashed", fontcolor="#111827", tooltip="rtr-edge [router]\nnamespace: sites/branch\ninterfaces (2):\n  eth0  ethernet  10.0.1.2/24\n  eth1  ethernet  10.0.2.1/24\nlinks (2):\n  eth0 — sites/hq/rtr-core:eth1  (cable, fiber, 10Gbps)\n  eth1 — sites/branch/sw-branch:uplink  (cable, copper, 1Gbps)", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>rtr-edge</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[router]</TD></TR>
      <TR><TD ALIGN="LEFT">eth0</TD><TD ALIGN="LEFT">10.0.1.2/24</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">eth1</TD><TD ALIGN="LEFT">10.0.2.1/24</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>
  >];
  "sites/branch/sw-branch" [shape=box, fillcolor="#dcf0dc", color="#16a34a", style="filled,rounded,dashed", fontcolor="#111827", tooltip="sw-branch [switch]\nnamespace: sites/branch\nlabels: tier=access\ninterfaces (2):\n  uplink  ethernet  10.0.2.2/24\n  port1  ethernet  disabled\nlinks (1):\n  uplink — sites/branch/rtr-edge:eth1  (cable, copper, 1Gbps)", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>sw-branch</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[switch]</TD></TR>
      <TR><TD ALIGN="LEFT">uplink</TD><TD ALIGN="LEFT">10.0.2.2/24</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>
  >];
  "sites/hq/rtr-core" [shape=hexagon, fillcolor="#1e3a8a", color="#ffffff", penwidth=4, fontcolor="#ffffff", fontsize=14, tooltip="rtr-core [router]\nnamespace: sites/hq\nlabels: role=core\ninterfaces (2):\n  eth0  ethernet  10.0.0.1/24\n  eth1  ethernet  10.0.1.1/24\nlinks (2):\n  eth0 — sites/hq/sw-hq-a:uplink  (cable, copper, 10Gbps)\n  eth1 — sites/branch/rtr-edge:eth0  (cable, fiber, 10Gbps)", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>rtr-core</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[router]</TD></TR>
      <TR><TD ALIGN="LEFT">eth0</TD><TD ALIGN="LEFT">10.0.0.1/24</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">eth1</TD><TD ALIGN="LEFT">10.0.1.1/24</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>
  >];
  "sites/hq/sw-hq-a" [shape=box3d, fillcolor="#dcf0dc", color="#16a34a", penwidth=3, fontcolor="#111827", fontsize=12, tooltip="sw-hq-a [switch]\nnamespace: sites/hq\nlabels: role=core\ninterfaces (2):\n  uplink  ethernet  10.0.0.2/24\n  port1  ethernet  disabled\nlinks (2):\n  uplink — sites/hq/rtr-core:eth0  (cable, copper, 10Gbps)\n  port1 — sites/hq/sw-hq-b:uplink  (cable, copper, 1Gbps)", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>sw-hq-a</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[switch]</TD></TR>
      <TR><TD ALIGN="LEFT">uplink</TD><TD ALIGN="LEFT">10.0.0.2/24</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>
  >];
  "sites/hq/sw-hq-b" [shape=box, fillcolor="#dcf0dc", color="#16a34a", style="filled,rounded", fontcolor="#111827", tooltip="sw-hq-b [switch]\nnamespace: sites/hq\nlabels: role=access, tier=access\ninterfaces (2):\n  uplink  ethernet  10.0.0.3/24\n  port1  ethernet  disabled\nlinks (2):\n  uplink — sites/hq/sw-hq-a:port1  (cable, copper, 1Gbps)\n  port1 — sites/hq/pc-desk:eno1  (cable, copper, 1Gbps)", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>sw-hq-b</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[switch]</TD></TR>
      <TR><TD ALIGN="LEFT">uplink</TD><TD ALIGN="LEFT">10.0.0.3/24</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>
  >];
  "sites/hq/pc-desk" [shape=rectangle, fillcolor="#ffffff66", color="#47556966", fontcolor="#11182766", tooltip="pc-desk [computer]\nnamespace: sites/hq\ninterfaces (1):\n  eno1  ethernet  10.0.0.20/24\nlinks (1):\n  eno1 — sites/hq/sw-hq-b:port1  (cable, copper, 1Gbps)", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>pc-desk</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[computer]</TD></TR>
      <TR><TD ALIGN="LEFT">eno1</TD><TD ALIGN="LEFT">10.0.0.20/24</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>
  >];

  "sites/hq/rtr-core" -- "sites/hq/sw-hq-a" [color="#dc2626", style=dotted, penwidth=3, fontcolor="#111827", label="eth0 -- uplink\n10Gbps", tooltip="cable cables/cbl-core-hq\nsites/hq/rtr-core:eth0 — sites/hq/sw-hq-a:uplink\nmedium: copper, speed: 10Gbps"];
  "sites/hq/sw-hq-a" -- "sites/hq/sw-hq-b" [color="#475569", style=solid, penwidth=1.5, fontcolor="#111827", label="port1 -- uplink\n1Gbps", tooltip="cable cables/cbl-hq-b\nsites/hq/sw-hq-a:port1 — sites/hq/sw-hq-b:uplink\nmedium: copper, speed: 1Gbps"];
  "sites/branch/rtr-edge" -- "sites/hq/rtr-core" [color="#475569", style=bold, penwidth=2.5, fontcolor="#111827", label="eth0 -- eth1\nfiber\n10Gbps", tooltip="cable cables/cbl-core-edge\nsites/branch/rtr-edge:eth0 — sites/hq/rtr-core:eth1\nmedium: fiber, speed: 10Gbps"];
  "sites/branch/rtr-edge" -- "sites/branch/sw-branch" [color="#475569", style=solid, penwidth=1.5, fontcolor="#111827", label="eth1 -- uplink\n1Gbps", tooltip="cable cables/cbl-edge-branch\nsites/branch/rtr-edge:eth1 — sites/branch/sw-branch:uplink\nmedium: copper, speed: 1Gbps"];
  "sites/hq/pc-desk" -- "sites/hq/sw-hq-b" [color="#475569", style=solid, penwidth=1.5, fontcolor="#111827", label="eno1 -- port1\n1Gbps", tooltip="cable cables/cbl-desk\nsites/hq/pc-desk:eno1 — sites/hq/sw-hq-b:port1\nmedium: copper, speed: 1Gbps"];
}
