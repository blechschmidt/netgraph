        <TR><TD COLSPAN="3" ALIGN="CENTER"><B>sw-north-dist-01</B></TD></TR>
        <TR><TD COLSPAN="3" ALIGN="CENTER">[switch]</TD></TR>
        <TR><TD ALIGN="LEFT">Vlan10</TD><TD ALIGN="LEFT">10.1.10.1/24, 2001:db8:1:10::1/64</TD><TD ALIGN="LEFT">vlan 10</TD></TR>
