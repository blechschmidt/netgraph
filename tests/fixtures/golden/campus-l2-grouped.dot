graph netviz {
  graph [
    rankdir=TB,
    splines=true,
    overlap=false,
    nodesep=0.5,
    ranksep=0.7,
    fontname="Helvetica,Arial,sans-serif",
    fontsize=12,
    label="Campus",
    labelloc=t,
    fontsize=16,
  ];
  node [fontname="Helvetica,Arial,sans-serif", fontsize=10, style=filled, penwidth=1.2];
  edge [fontname="Helvetica,Arial,sans-serif", fontsize=8];

  subgraph cluster_area_0 {
    label="Site North";
    style="rounded,filled,dashed";
    color="#818b86";
    fillcolor="#ecfdf5";
    fontcolor="#818b86";
    fontsize=11;
    labeljust=l;
    margin=12;
    "sites/north/access/sw-north-acc-01" [shape=box3d, fillcolor="#dcf0dc", color="#16a34a", tooltip="sw-north-acc-01 [switch]\nnamespace: sites/north/access\nAccess switch 01, North campus. Layer-2 only: the ports are untagged access ports, and the switch's own management address lives on the Vlan99 SVI rather than on a port (NV-V009).\nlabels: env=prod, role=access, site=north\nvlans: 1,10,20,30,99\ninterfaces (6):\n  br0  bridge\n  Vlan99  vlan  10.1.99.11/24  vlan 99 (access)\n  GigabitEthernet1/0/1  ethernet  vlan 10 (access)  00:1b:0d:01:a1:01\n  GigabitEthernet1/0/2  ethernet  vlan 20 (access)  00:1b:0d:01:a1:02\n  GigabitEthernet1/0/3  ethernet  disabled  vlan 10 (access)  00:1b:0d:01:a1:03\n  TenGigabitEthernet1/1/1  ethernet  vlan 1,10,20,30,99 (trunk)  00:1b:0d:01:a1:11\nlinks (3):\n  TenGigabitEthernet1/1/1 — sites/north/distribution/sw-north-dist-01:Ethernet49/1  (cable, fiber, 10Gbps)  vlan 1,10,20,30,99\n  GigabitEthernet1/0/1 — sites/north/hosts/pc-north-01:eno1  (cable, copper, 1Gbps)  vlan 10\n  GigabitEthernet1/0/2 — sites/north/hosts/srv-north-01:eth0  (cable, copper, 1Gbps)  vlan 20", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
        <TR><TD COLSPAN="3" ALIGN="CENTER"><B>sw-north-acc-01</B></TD></TR>
        <TR><TD COLSPAN="3" ALIGN="CENTER">[switch]</TD></TR>
        <TR><TD ALIGN="LEFT">Vlan99</TD><TD ALIGN="LEFT">10.1.99.11/24</TD><TD ALIGN="LEFT">vlan 99</TD></TR>
        <TR><TD ALIGN="LEFT">GigabitEthernet1/0/1</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
        <TR><TD ALIGN="LEFT">GigabitEthernet1/0/2</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 20</TD></TR>
        <TR><TD ALIGN="LEFT">GigabitEthernet1/0/3</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
        <TR><TD ALIGN="LEFT">TenGigabitEthernet1/1/1</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 1,10,20,30,99</TD></TR>
      </TABLE>
    >];
    "sites/north/access/sw-north-acc-02" [shape=box3d, fillcolor="#dcf0dc", color="#16a34a", tooltip="sw-north-acc-02 [switch]\nnamespace: sites/north/access\nAccess switch 02, North campus - second floor riser.\nlabels: env=prod, role=access, site=north\nvlans: 1,10,20,30,99\ninterfaces (5):\n  br0  bridge\n  Vlan99  vlan  10.1.99.12/24  vlan 99 (access)\n  GigabitEthernet1/0/1  ethernet  vlan 10 (access)  00:1b:0d:01:a2:01\n  GigabitEthernet1/0/2  ethernet  disabled  vlan 20 (access)  00:1b:0d:01:a2:02\n  TenGigabitEthernet1/1/1  ethernet  vlan 1,10,20,30,99 (trunk)  00:1b:0d:01:a2:11\nlinks (2):\n  TenGigabitEthernet1/1/1 — sites/north/distribution/sw-north-dist-01:Ethernet50/1  (cable, fiber, 10Gbps)  vlan 1,10,20,30,99\n  GigabitEthernet1/0/1 — sites/north/hosts/pc-north-02:eno1  (cable, copper, 1Gbps)  vlan 10", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
        <TR><TD COLSPAN="3" ALIGN="CENTER"><B>sw-north-acc-02</B></TD></TR>
        <TR><TD COLSPAN="3" ALIGN="CENTER">[switch]</TD></TR>
        <TR><TD ALIGN="LEFT">Vlan99</TD><TD ALIGN="LEFT">10.1.99.12/24</TD><TD ALIGN="LEFT">vlan 99</TD></TR>
        <TR><TD ALIGN="LEFT">GigabitEthernet1/0/1</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
        <TR><TD ALIGN="LEFT">GigabitEthernet1/0/2</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 20</TD></TR>
        <TR><TD ALIGN="LEFT">TenGigabitEthernet1/1/1</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 1,10,20,30,99</TD></TR>
      </TABLE>
    >];
    "sites/north/access/sw-north-acc-03" [shape=box3d, fillcolor="#dcf0dc", color="#16a34a", tooltip="sw-north-acc-03 [switch]\nnamespace: sites/north/access\nAccess switch 03, North campus - third floor riser.\nlabels: env=prod, role=access, site=north\nvlans: 1,10,20,30,99\ninterfaces (51):\n  br0  bridge\n  Vlan99  vlan  10.1.99.13/24  vlan 99 (access)\n  GigabitEthernet1/0/1  ethernet  disabled  vlan 10 (access)\n  GigabitEthernet1/0/2  ethernet  disabled  vlan 10 (access)\n  GigabitEthernet1/0/3  ethernet  disabled  vlan 10 (access)\n  GigabitEthernet1/0/4  ethernet  disabled  vlan 10 (access)\n  GigabitEthernet1/0/5  ethernet  disabled  vlan 10 (access)\n  GigabitEthernet1/0/6  ethernet  disabled  vlan 10 (access)\n  (+43 more)\nlinks (1):\n  TenGigabitEthernet1/1/1 — sites/north/distribution/sw-north-dist-01:Ethernet51/1  (cable, fiber, 10Gbps)  vlan 1,10,20,30,99", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
        <TR><TD COLSPAN="3" ALIGN="CENTER"><B>sw-north-acc-03</B></TD></TR>
