  "hosts/laptop" -- "hosts/adp-usb-eth" [color="#9ca3af", style=dotted, penwidth=2.0, pos="1176,420 1176,411.15 1176,406.9 1176,393.44 1176,379.98 1176,353.96 1176,339.26 1176,324.56 1176,316.58 1176,305.24", label="usb0\nusb\n5Gbps", tooltip="attachment hosts/adp-usb-eth#upstream\nhosts/laptop — hosts/adp-usb-eth:usb0\nmedium: copper, speed: 5Gbps, label: usb"];
