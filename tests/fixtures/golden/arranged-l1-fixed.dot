  "hosts/srv-nas" -- "switches/sw-home" [color="#4a4a4a", style=solid, penwidth=1.5, pos="150.97,237.69 157.27,233.31 162.13,229.4 169.88,224.55 177.63,219.7 188.42,213.03 197.44,208.6 206.46,204.17 188.8,212.04 224,198 259.2,183.96 339.26,143.21 408.62,124.33 477.98,105.45 581.33,94.11 640.14,84.7 698.95,75.29 721.05,73.47 761.5,67.86", label="eth0 -- port3\nH-003\n1Gbps\nvlan 10", tooltip="cable cables/cbl-sw-nas\nhosts/srv-nas:eth0 — switches/sw-home:port3\nmedium: copper, speed: 1Gbps, length: 0.5 m, label: H-003\nvlans: 10"];
  "hosts/adp-usb-eth" -- "switches/sw-home" [color="#4a4a4a", style=solid, penwidth=1.5, pos="1123.93,236.76 1108.08,226.35 1098.06,219.62 1076.4,205.52 1054.74,191.42 1017.96,167.76 993.98,152.16 970,136.56 952.99,125.34 932.5,111.94", label="enx001122334455 -- port4\nH-004\n1Gbps\nvlan 10", tooltip="cable cables/cbl-sw-dongle\nhosts/adp-usb-eth:enx001122334455 — switches/sw-home:port4\nmedium: copper, speed: 1Gbps, length: 10 m, label: H-004\nvlans: 10"];
