        <TR><TD COLSPAN="3" ALIGN="CENTER">[switch, id 10.3.0.2, ospf area 0.0.0.0]</TD></TR>
        <TR><TD ALIGN="LEFT">vrf mgmt</TD><TD ALIGN="LEFT">65001:99</TD><TD ALIGN="LEFT"></TD></TR>
