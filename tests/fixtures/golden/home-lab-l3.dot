graph netgraph {
  graph [
    rankdir=TB,
    splines=true,
    overlap=false,
    nodesep=0.5,
    ranksep=0.7,
    fontname="Helvetica,Arial,sans-serif",
    fontsize=12,
    label="Home lab, layer 3",
    labelloc=t,
    fontsize=16,
  ];
  node [fontname="Helvetica,Arial,sans-serif", fontsize=10, style=filled, penwidth=1.2];
  edge [fontname="Helvetica,Arial,sans-serif", fontsize=8];

  "hosts/adp-usb-eth" [shape=ellipse, fillcolor="#fdf0e3", color="#ea580c", style="filled,dashed", tooltip="USB 3.0 gigabit dongle. `upstream.attached_to` is what joins it to the\nlaptop - there is deliberately no cable between the two (NG-X005).\n", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>adp-usb-eth</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[adapter]</TD></TR>
    </TABLE>
  >];
  "hosts/pc-desk" [shape=rectangle, fillcolor="#f5f5f5", color="#6b7280", tooltip="Desktop workstation in the study", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>pc-desk</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[computer]</TD></TR>
    </TABLE>
  >];
  "hosts/srv-nas" [shape=cylinder, fillcolor="#eae2f5", color="#7c3aed", tooltip="Backup and media server", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>srv-nas</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[server]</TD></TR>
    </TABLE>
  >];
  "routers/rtr-home" [shape=diamond, fillcolor="#dbe9f6", color="#2563eb", tooltip="Home edge router. Terminates the ISP hand-off on wan0 and is the default\ngateway for the single home VLAN (10).\n", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>rtr-home</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[router]</TD></TR>
      <TR><TD ALIGN="LEFT">lan0</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
    </TABLE>
  >];
  "switches/sw-home" [shape=box3d, fillcolor="#dcf0dc", color="#16a34a", tooltip="Eight-port desktop switch in the hallway cabinet", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>sw-home</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[switch]</TD></TR>
      <TR><TD ALIGN="LEFT">Vlan10</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
      <TR><TD ALIGN="LEFT">port1</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
      <TR><TD ALIGN="LEFT">port2</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
      <TR><TD ALIGN="LEFT">port3</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
      <TR><TD ALIGN="LEFT">port4</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
      <TR><TD ALIGN="LEFT">port5</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
    </TABLE>
  >];
  "subnet:192.0.2.1/32" [shape=box, fillcolor="#e0f2f1", color="#0f766e", style="filled,rounded", tooltip="ipv4 subnet 192.0.2.1/32: 1 element, 1 address", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>192.0.2.1/32</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[ipv4 subnet]</TD></TR>
    </TABLE>
  >];
  "subnet:192.168.10.0/24" [shape=box, fillcolor="#e0f2f1", color="#0f766e", style="filled,rounded", tooltip="ipv4 subnet 192.168.10.0/24: 5 elements, 5 addresses", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>192.168.10.0/24</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[ipv4 subnet]</TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">vlan 10</TD></TR>
    </TABLE>
  >];
  "subnet:203.0.113.0/30" [shape=box, fillcolor="#e0f2f1", color="#0f766e", style="filled,rounded", tooltip="ipv4 subnet 203.0.113.0/30: 1 element, 1 address", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>203.0.113.0/30</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[ipv4 subnet]</TD></TR>
    </TABLE>
  >];
  "subnet:2001:db8::1/128" [shape=box, fillcolor="#e0f2f1", color="#0f766e", style="filled,rounded", tooltip="ipv6 subnet 2001:db8::1/128: 1 element, 1 address", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>2001:db8::1/128</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[ipv6 subnet]</TD></TR>
    </TABLE>
  >];
  "subnet:2001:db8:10::/64" [shape=box, fillcolor="#e0f2f1", color="#0f766e", style="filled,rounded", tooltip="ipv6 subnet 2001:db8:10::/64: 4 elements, 4 addresses", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>2001:db8:10::/64</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[ipv6 subnet]</TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">vlan 10</TD></TR>
    </TABLE>
  >];

  "hosts/adp-usb-eth" -- "subnet:192.168.10.0/24" [color="#0f766e", style=solid, label="enx001122334455\n192.168.10.30/24", tooltip="hosts/adp-usb-eth:enx001122334455 — 192.168.10.30/24"];
  "hosts/adp-usb-eth" -- "subnet:2001:db8:10::/64" [color="#0f766e", style=solid, label="enx001122334455\n2001:db8:10::30/64", tooltip="hosts/adp-usb-eth:enx001122334455 — 2001:db8:10::30/64"];
  "hosts/pc-desk" -- "subnet:192.168.10.0/24" [color="#0f766e", style=solid, label="eno1\n192.168.10.20/24", tooltip="hosts/pc-desk:eno1 — 192.168.10.20/24"];
  "hosts/pc-desk" -- "subnet:2001:db8:10::/64" [color="#0f766e", style=solid, label="eno1\n2001:db8:10::20/64", tooltip="hosts/pc-desk:eno1 — 2001:db8:10::20/64"];
  "hosts/srv-nas" -- "subnet:192.168.10.0/24" [color="#0f766e", style=solid, label="eth0\n192.168.10.10/24", tooltip="hosts/srv-nas:eth0 — 192.168.10.10/24"];
  "hosts/srv-nas" -- "subnet:2001:db8:10::/64" [color="#0f766e", style=solid, label="eth0\n2001:db8:10::10/64", tooltip="hosts/srv-nas:eth0 — 2001:db8:10::10/64"];
  "routers/rtr-home" -- "subnet:192.0.2.1/32" [color="#0f766e", style=solid, label="lo0\n192.0.2.1/32", tooltip="routers/rtr-home:lo0 — 192.0.2.1/32"];
  "routers/rtr-home" -- "subnet:2001:db8::1/128" [color="#0f766e", style=solid, label="lo0\n2001:db8::1/128", tooltip="routers/rtr-home:lo0 — 2001:db8::1/128"];
  "routers/rtr-home" -- "subnet:203.0.113.0/30" [color="#0f766e", style=solid, label="wan0\n203.0.113.2/30", tooltip="routers/rtr-home:wan0 — 203.0.113.2/30"];
  "routers/rtr-home" -- "subnet:192.168.10.0/24" [color="#0f766e", style=solid, label="lan0\n192.168.10.1/24\nvlan 10", tooltip="routers/rtr-home:lan0 — 192.168.10.1/24 — vlans: 10"];
  "routers/rtr-home" -- "subnet:2001:db8:10::/64" [color="#0f766e", style=solid, label="lan0\n2001:db8:10::1/64\nvlan 10", tooltip="routers/rtr-home:lan0 — 2001:db8:10::1/64 — vlans: 10"];
  "switches/sw-home" -- "subnet:192.168.10.0/24" [color="#0f766e", style=solid, label="Vlan10\n192.168.10.2/24\nvlan 10", tooltip="switches/sw-home:Vlan10 — 192.168.10.2/24 — vlans: 10"];
}
