graph netviz {
  graph [
    rankdir=TB,
    splines=true,
    overlap=false,
    nodesep=0.5,
    ranksep=0.7,
    fontname="Helvetica,Arial,sans-serif",
    fontsize=12,
    label="Campus, collapsed to sites",
    labelloc=t,
    fontsize=16,
  ];
  node [fontname="Helvetica,Arial,sans-serif", fontsize=10, style=filled, penwidth=1.2];
  edge [fontname="Helvetica,Arial,sans-serif", fontsize=8];

  "ns:sites/north" [id="node-ns_sites_north", shape=folder, fillcolor="#e2e8f0", color="#475569", tooltip="sites/north [namespace]\nnamespace: sites\ncollapsed namespace sites/north: 8 elements: 2 computers, 1 router, 1 server, 4 switches\n7 links inside, not drawn\nsubnets: 10.1.0.0/30, 10.1.10.0/24, 10.1.20.0/24, 10.1.99.0/24, 192.0.2.1/32, 198.51.100.0/30, (+7 more)\nelements: sites/north/access/sw-north-acc-01, sites/north/access/sw-north-acc-02, sites/north/access/sw-north-acc-03, sites/north/core/rtr-north-core-01, sites/north/distribution/sw-north-dist-01, sites/north/hosts/pc-north-01, (+2 more)\nvlans: 1,10,20,30,99\nlinks (2):\n  xe-0/0/1 — ns:sites/south:xe-0/0/2  (cable, fiber, 10Gbps)\n  xe-0/0/2 — ns:sites/west:xe-0/0/1  (cable, fiber, 10Gbps)", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>sites/north</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[namespace, 8 elements]</TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">2 computers, 1 router, 1 server, 4 switches</TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">7 links inside</TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">vlan 1,10,20,30,99</TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">10.1.0.0/30</TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">10.1.10.0/24</TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">10.1.20.0/24</TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">10.1.99.0/24</TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">(+9 more)</TD></TR>
    </TABLE>
  >];
  "ns:sites/south" [id="node-ns_sites_south", shape=folder, fillcolor="#e2e8f0", color="#475569", tooltip="sites/south [namespace]\nnamespace: sites\ncollapsed namespace sites/south: 7 elements: 2 computers, 1 router, 1 server, 3 switches\n6 links inside, not drawn\nsubnets: 10.2.0.0/30, 10.2.10.0/24, 10.2.20.0/24, 10.2.99.0/24, 192.0.2.2/32, 198.51.100.0/30, (+7 more)\nelements: sites/south/access/sw-south-acc-01, sites/south/access/sw-south-acc-02, sites/south/core/rtr-south-core-01, sites/south/distribution/sw-south-dist-01, sites/south/hosts/pc-south-01, sites/south/hosts/srv-south-01, (+1 more)\nvlans: 1,10,20,30,99\nlinks (2):\n  xe-0/0/2 — ns:sites/north:xe-0/0/1  (cable, fiber, 10Gbps)\n  xe-0/0/1 — ns:sites/west:xe-0/0/2  (cable, fiber, 10Gbps)", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>sites/south</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[namespace, 7 elements]</TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">2 computers, 1 router, 1 server, 3 switches</TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">6 links inside</TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">vlan 1,10,20,30,99</TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">10.2.0.0/30</TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">10.2.10.0/24</TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">10.2.20.0/24</TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">10.2.99.0/24</TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">(+9 more)</TD></TR>
    </TABLE>
  >];
  "ns:sites/west" [id="node-ns_sites_west", shape=folder, fillcolor="#e2e8f0", color="#475569", tooltip="sites/west [namespace]\nnamespace: sites\ncollapsed namespace sites/west: 7 elements: 2 computers, 1 router, 1 server, 3 switches\n6 links inside, not drawn\nsubnets: 10.3.0.0/30, 10.3.10.0/24, 10.3.20.0/24, 10.3.99.0/24, 192.0.2.3/32, 198.51.100.4/30, (+7 more)\nelements: sites/west/access/sw-west-acc-01, sites/west/access/sw-west-acc-02, sites/west/core/rtr-west-core-01, sites/west/distribution/sw-west-dist-01, sites/west/hosts/pc-west-01, sites/west/hosts/srv-west-01, (+1 more)\nvlans: 1,10,20,30,99\nlinks (2):\n  xe-0/0/2 — ns:sites/south:xe-0/0/1  (cable, fiber, 10Gbps)\n  xe-0/0/1 — ns:sites/north:xe-0/0/2  (cable, fiber, 10Gbps)", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>sites/west</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[namespace, 7 elements]</TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">2 computers, 1 router, 1 server, 3 switches</TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">6 links inside</TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">vlan 1,10,20,30,99</TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">10.3.0.0/30</TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">10.3.10.0/24</TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">10.3.20.0/24</TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">10.3.99.0/24</TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">(+9 more)</TD></TR>
    </TABLE>
  >];

  "annotation:note-why-fibre" [id="note-why-fibre", shape=note, style=filled, fillcolor="#fef3c7", color="#8b856d", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
    <TR><TD ALIGN="LEFT" BALIGN="LEFT">The backbone is <B>single-mode fibre</B>: 4.2 km between sites, which is past what copper does at any speed.</TD></TR>
    <TR><TD ALIGN="LEFT" BALIGN="LEFT">&#8226; <FONT FACE="monospace">os2</FONT>, LC, 10Gbps</TD></TR>
    <TR><TD ALIGN="LEFT" BALIGN="LEFT">&#8226; the ring survives one break</TD></TR>
    </TABLE>
  >];

  "ns:sites/north" -- "ns:sites/south" [id="edge-backbone_cbl-bb-north-south", color="#d97706", style=bold, penwidth=2.5, label="xe-0/0/1 -- xe-0/0/2\nBB-NS\nfiber\n10Gbps", tooltip="cable backbone/cbl-bb-north-south\nns:sites/north:xe-0/0/1 — ns:sites/south:xe-0/0/2\nmedium: fiber, speed: 10Gbps, length: 4200 m, label: BB-NS"];
  "ns:sites/south" -- "ns:sites/west" [id="edge-backbone_cbl-bb-south-west", color="#d97706", style=bold, penwidth=2.5, label="xe-0/0/1 -- xe-0/0/2\nBB-SW\nfiber\n10Gbps", tooltip="cable backbone/cbl-bb-south-west\nns:sites/south:xe-0/0/1 — ns:sites/west:xe-0/0/2\nmedium: fiber, speed: 10Gbps, length: 4200 m, label: BB-SW"];
  "ns:sites/north" -- "ns:sites/west" [id="edge-backbone_cbl-bb-west-north", color="#d97706", style=bold, penwidth=2.5, label="xe-0/0/2 -- xe-0/0/1\nBB-WN\nfiber\n10Gbps", tooltip="cable backbone/cbl-bb-west-north\nns:sites/north:xe-0/0/2 — ns:sites/west:xe-0/0/1\nmedium: fiber, speed: 10Gbps, length: 4200 m, label: BB-WN"];
}
