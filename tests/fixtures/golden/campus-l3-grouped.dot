  "annotation:note-why-fibre" [shape=note, style=filled, fillcolor="#fef3c7", color="#8b856d", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
    <TR><TD ALIGN="LEFT" BALIGN="LEFT">The backbone is <B>single-mode fibre</B>: 4.2 km between sites, which is past what copper does at any speed.</TD></TR>
    <TR><TD ALIGN="LEFT" BALIGN="LEFT">&#8226; <FONT FACE="monospace">os2</FONT>, LC, 10Gbps</TD></TR>
    <TR><TD ALIGN="LEFT" BALIGN="LEFT">&#8226; the ring survives one break</TD></TR>
    </TABLE>
  >];
  "annotation:note-mgmt-is-not-routed" [shape=note, style=filled, fillcolor="#fef3c7", color="#8b856d", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
    <TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT FACE="monospace">Vlan99</FONT> lives in the <I>mgmt</I> VRF and its default route is a discard route, so management does not leave the site.</TD></TR>
    </TABLE>
  >];

