graph netviz {
  graph [
    rankdir=TB,
    splines=true,
    overlap=false,
    nodesep=0.5,
    ranksep=0.7,
    fontname="Helvetica,Arial,sans-serif",
    fontsize=12,
    label="Campus, layer 3",
    labelloc=t,
    fontsize=16,
  ];
  node [fontname="Helvetica,Arial,sans-serif", fontsize=10, style=filled, penwidth=1.2];
  edge [fontname="Helvetica,Arial,sans-serif", fontsize=8];

  subgraph cluster_area_0 {
    label="Backbone ring";
    style="rounded,filled";
    color="#8b7c7c";
    fillcolor="#fee2e2";
    fontcolor="#8b7c7c";
    fontsize=11;
    labeljust=l;
    margin=12;
    "sites/north/core/rtr-north-core-01" [shape=diamond, fillcolor="#dbe9f6", color="#2563eb", tooltip="rtr-north-core-01 [router]\nnamespace: sites/north/core\nLayer-3 core router for the North campus. It routes between the campus VLANs (whose gateways sit on sw-north-dist-01) and carries the two backbone fibres of the inter-site ring.\nlabels: env=prod, role=core, site=north\ninterfaces (4):\n  lo0  loopback  192.0.2.1/32, 2001:db8::1/128\n  xe-0/0/0  ethernet  10.1.0.1/30, 2001:db8:1::1/64  00:05:86:01:c0:00\n  xe-0/0/1  ethernet  198.51.100.1/30, 2001:db8:ff:1::1/64  00:05:86:01:c0:01\n  xe-0/0/2  ethernet  198.51.100.10/30, 2001:db8:ff:3::2/64  00:05:86:01:c0:02\nlinks (8):\n  lo0 — subnet:192.0.2.1/32  (subnet)\n  lo0 — subnet:2001:db8::1/128  (subnet)\n  xe-0/0/0 — subnet:10.1.0.0/30  (subnet)\n  xe-0/0/0 — subnet:2001:db8:1::/64  (subnet)\n  xe-0/0/1 — subnet:198.51.100.0/30  (subnet)\n  xe-0/0/1 — subnet:2001:db8:ff:1::/64  (subnet)\n  xe-0/0/2 — subnet:198.51.100.8/30  (subnet)\n  xe-0/0/2 — subnet:2001:db8:ff:3::/64  (subnet)", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
        <TR><TD COLSPAN="3" ALIGN="CENTER"><B>rtr-north-core-01</B></TD></TR>
        <TR><TD COLSPAN="3" ALIGN="CENTER">[router]</TD></TR>
      </TABLE>
    >];
    "sites/south/core/rtr-south-core-01" [shape=diamond, fillcolor="#dbe9f6", color="#2563eb", tooltip="rtr-south-core-01 [router]\nnamespace: sites/south/core\nLayer-3 core router for the South campus. It routes between the campus VLANs (whose gateways sit on sw-south-dist-01) and carries the two backbone fibres of the inter-site ring.\nlabels: env=prod, role=core, site=south\ninterfaces (4):\n  lo0  loopback  192.0.2.2/32, 2001:db8::2/128\n  xe-0/0/0  ethernet  10.2.0.1/30, 2001:db8:2::1/64  00:05:86:02:c0:00\n  xe-0/0/1  ethernet  198.51.100.5/30, 2001:db8:ff:2::1/64  00:05:86:02:c0:01\n  xe-0/0/2  ethernet  198.51.100.2/30, 2001:db8:ff:1::2/64  00:05:86:02:c0:02\nlinks (8):\n  lo0 — subnet:192.0.2.2/32  (subnet)\n  lo0 — subnet:2001:db8::2/128  (subnet)\n  xe-0/0/0 — subnet:10.2.0.0/30  (subnet)\n  xe-0/0/0 — subnet:2001:db8:2::/64  (subnet)\n  xe-0/0/1 — subnet:198.51.100.4/30  (subnet)\n  xe-0/0/1 — subnet:2001:db8:ff:2::/64  (subnet)\n  xe-0/0/2 — subnet:198.51.100.0/30  (subnet)\n  xe-0/0/2 — subnet:2001:db8:ff:1::/64  (subnet)", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
        <TR><TD COLSPAN="3" ALIGN="CENTER"><B>rtr-south-core-01</B></TD></TR>
        <TR><TD COLSPAN="3" ALIGN="CENTER">[router]</TD></TR>
      </TABLE>
    >];
    "sites/west/core/rtr-west-core-01" [shape=diamond, fillcolor="#dbe9f6", color="#2563eb", tooltip="rtr-west-core-01 [router]\nnamespace: sites/west/core\nLayer-3 core router for the West annexe. It routes between the campus VLANs (whose gateways sit on sw-west-dist-01) and carries the two backbone fibres of the inter-site ring.\nlabels: env=prod, role=core, site=west\ninterfaces (4):\n  lo0  loopback  192.0.2.3/32, 2001:db8::3/128\n  xe-0/0/0  ethernet  10.3.0.1/30, 2001:db8:3::1/64  00:05:86:03:c0:00\n  xe-0/0/1  ethernet  198.51.100.9/30, 2001:db8:ff:3::1/64  00:05:86:03:c0:01\n  xe-0/0/2  ethernet  198.51.100.6/30, 2001:db8:ff:2::2/64  00:05:86:03:c0:02\nlinks (8):\n  lo0 — subnet:192.0.2.3/32  (subnet)\n  lo0 — subnet:2001:db8::3/128  (subnet)\n  xe-0/0/0 — subnet:10.3.0.0/30  (subnet)\n  xe-0/0/0 — subnet:2001:db8:3::/64  (subnet)\n  xe-0/0/1 — subnet:198.51.100.8/30  (subnet)\n  xe-0/0/1 — subnet:2001:db8:ff:3::/64  (subnet)\n  xe-0/0/2 — subnet:198.51.100.4/30  (subnet)\n  xe-0/0/2 — subnet:2001:db8:ff:2::/64  (subnet)", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
        <TR><TD COLSPAN="3" ALIGN="CENTER"><B>rtr-west-core-01</B></TD></TR>
        <TR><TD COLSPAN="3" ALIGN="CENTER">[router]</TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_0 {
    label="sites/north/access";
    tooltip="namespace sites/north/access\n3 elements: 3 switches\nvlans: 1,10,20,30,99";
    style=rounded;
    color="#9ca3af";
    fontcolor="#4b5563";
    fontsize=11;
    labeljust=l;
    margin=12;
    "sites/north/access/sw-north-acc-01" [shape=box3d, fillcolor="#dcf0dc", color="#16a34a", tooltip="sw-north-acc-01 [switch]\nnamespace: sites/north/access\nAccess switch 01, North campus. Layer-2 only: the ports are untagged access ports, and the switch's own management address lives on the Vlan99 SVI rather than on a port (NG-V009).\nlabels: env=prod, role=access, site=north\nvlans: 1,10,20,30,99\ninterfaces (6):\n  br0  bridge\n  Vlan99  vlan  10.1.99.11/24  vlan 99 (access)\n  GigabitEthernet1/0/1  ethernet  vlan 10 (access)  00:1b:0d:01:a1:01\n  GigabitEthernet1/0/2  ethernet  vlan 20 (access)  00:1b:0d:01:a1:02\n  GigabitEthernet1/0/3  ethernet  disabled  vlan 10 (access)  00:1b:0d:01:a1:03\n  TenGigabitEthernet1/1/1  ethernet  vlan 1,10,20,30,99 (trunk)  00:1b:0d:01:a1:11\nlinks (1):\n  Vlan99 — subnet:mgmt/10.1.99.0/24  (subnet)  vlan 99", label=<
