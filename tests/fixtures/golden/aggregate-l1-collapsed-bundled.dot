graph netviz {
  graph [
    rankdir=TB,
    splines=true,
    overlap=false,
    nodesep=0.5,
    ranksep=0.7,
    fontname="Helvetica,Arial,sans-serif",
    fontsize=12,
    label="Collapsed and bundled",
    labelloc=t,
    fontsize=16,
  ];
  node [fontname="Helvetica,Arial,sans-serif", fontsize=10, style=filled, penwidth=1.2];
  edge [fontname="Helvetica,Arial,sans-serif", fontsize=8];

  subgraph cluster_0 {
    label="sites";
    tooltip="namespace sites\n2 elements: 2 namespaces\nvlans: 10";
    style=rounded;
    color="#9ca3af";
    fontcolor="#4b5563";
    fontsize=11;
    labeljust=l;
    margin=12;
    "ns:sites/east" [shape=folder, fillcolor="#e2e8f0", color="#475569", tooltip="sites/east [namespace]\nnamespace: sites\ncollapsed namespace sites/east: 3 elements: 1 computer, 2 switches\n2 links inside, not drawn\nsubnets: 10.20.0.0/24\nelements: sites/east/pc-east-01, sites/east/sw-east-01, sites/east/sw-east-02\nvlans: 10\nlinks (1):\n  ns:sites/west  (cable, copper, 2Gbps)  vlan 10", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
        <TR><TD COLSPAN="3" ALIGN="CENTER"><B>sites/east</B></TD></TR>
        <TR><TD COLSPAN="3" ALIGN="CENTER">[namespace, 3 elements]</TD></TR>
        <TR><TD COLSPAN="3" ALIGN="CENTER">1 computer, 2 switches</TD></TR>
        <TR><TD COLSPAN="3" ALIGN="CENTER">2 links inside</TD></TR>
        <TR><TD COLSPAN="3" ALIGN="CENTER">vlan 10</TD></TR>
        <TR><TD COLSPAN="3" ALIGN="CENTER">10.20.0.0/24</TD></TR>
      </TABLE>
    >];
    "ns:sites/west" [shape=folder, fillcolor="#e2e8f0", color="#475569", tooltip="sites/west [namespace]\nnamespace: sites\ncollapsed namespace sites/west: 1 element: 1 switch\nsubnets: 10.20.0.0/24\nelements: sites/west/sw-west-01\nvlans: 10\nlinks (1):\n  ns:sites/east  (cable, copper, 2Gbps)  vlan 10", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
        <TR><TD COLSPAN="3" ALIGN="CENTER"><B>sites/west</B></TD></TR>
        <TR><TD COLSPAN="3" ALIGN="CENTER">[namespace, 1 element]</TD></TR>
        <TR><TD COLSPAN="3" ALIGN="CENTER">1 switch</TD></TR>
        <TR><TD COLSPAN="3" ALIGN="CENTER">vlan 10</TD></TR>
        <TR><TD COLSPAN="3" ALIGN="CENTER">10.20.0.0/24</TD></TR>
      </TABLE>
    >];
  }

  "ns:sites/east" -- "ns:sites/west" [color="#4a4a4a", style=solid, penwidth=1.5, weight=2, label="2 links\n2Gbps\nvlan 10", tooltip="cable cables/cbl-east-west#bundle\nns:sites/east — ns:sites/west\nbundled links (2):\n  ns:sites/east:GigabitEthernet1/0/20 — ns:sites/west:GigabitEthernet1/0/20  (cables/cbl-east-west, copper, 1Gbps, CBL-EAST-WEST)\n  ns:sites/east:GigabitEthernet1/0/21 — ns:sites/west:GigabitEthernet1/0/21  (cables/cbl-east-west-2, copper, 1Gbps, CBL-EAST-WEST-2)\nmedium: copper, speed: 2Gbps\nvlans: 10"];
}
