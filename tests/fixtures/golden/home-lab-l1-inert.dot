graph netgraph {
  graph [
    rankdir=TB,
    splines=true,
    overlap=false,
    nodesep=0.5,
    ranksep=0.7,
    fontname="Helvetica,Arial,sans-serif",
    fontsize=12,
  ];
  node [fontname="Helvetica,Arial,sans-serif", fontsize=10, style=filled, penwidth=1.2];
  edge [fontname="Helvetica,Arial,sans-serif", fontsize=8];

  "hosts/adp-usb-eth" [shape=ellipse, fillcolor="#fdf0e3", color="#ea580c", style="filled,dashed", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>adp-usb-eth</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[adapter]</TD></TR>
    </TABLE>
  >];
  "hosts/laptop" [shape=rectangle, fillcolor="#f5f5f5", color="#6b7280", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>laptop</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[computer]</TD></TR>
    </TABLE>
  >];
  "hosts/pc-desk" [shape=rectangle, fillcolor="#f5f5f5", color="#6b7280", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>pc-desk</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[computer]</TD></TR>
    </TABLE>
  >];
  "hosts/phone" [shape=rectangle, fillcolor="#f5f5f5", color="#6b7280", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>phone</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[computer]</TD></TR>
    </TABLE>
  >];
  "hosts/srv-nas" [shape=cylinder, fillcolor="#eae2f5", color="#7c3aed", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>srv-nas</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[server]</TD></TR>
    </TABLE>
  >];
  "routers/rtr-home" [shape=diamond, fillcolor="#dbe9f6", color="#2563eb", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>rtr-home</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[router]</TD></TR>
    </TABLE>
  >];
  "switches/sw-home" [shape=box3d, fillcolor="#dcf0dc", color="#16a34a", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>sw-home</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[switch]</TD></TR>
    </TABLE>
  >];
  "wireless/ap-home" [shape=box3d, fillcolor="#dcf0dc", color="#16a34a", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>ap-home</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[switch]</TD></TR>
    </TABLE>
  >];

  "routers/rtr-home" -- "switches/sw-home" [color="#4a4a4a", style=solid, penwidth=1.5, label="lan0 -- port1\nH-001\n1Gbps"];
  "hosts/pc-desk" -- "switches/sw-home" [color="#4a4a4a", style=solid, penwidth=1.5, label="eno1 -- port2\nH-002\n1Gbps"];
  "hosts/srv-nas" -- "switches/sw-home" [color="#4a4a4a", style=solid, penwidth=1.5, label="eth0 -- port3\nH-003\n1Gbps"];
  "hosts/adp-usb-eth" -- "switches/sw-home" [color="#4a4a4a", style=solid, penwidth=1.5, label="enx001122334455 -- port4\nH-004\n1Gbps"];
  "wireless/ap-home" -- "switches/sw-home" [color="#4a4a4a", style=solid, penwidth=1.5, label="eth0 -- port5\nH-005\n1Gbps"];
  "wireless/ap-home" -- "hosts/phone" [color="#2563eb", style=dashed, label="wlan0 -- en0\nwireless"];
  "hosts/laptop" -- "hosts/adp-usb-eth" [color="#9ca3af", style=dotted, penwidth=2.0, label="usb0\nusb\n5Gbps"];
}
