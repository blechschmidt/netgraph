graph netgraph {
  graph [
    rankdir=TB,
    splines=true,
    overlap=false,
    nodesep=0.5,
    ranksep=0.7,
    fontname="Helvetica,Arial,sans-serif",
    fontsize=12,
    label="Home lab, layer 2",
    labelloc=t,
    fontsize=16,
  ];
  node [fontname="Helvetica,Arial,sans-serif", fontsize=10, style=filled, penwidth=1.2];
  edge [fontname="Helvetica,Arial,sans-serif", fontsize=8];

  "hosts/adp-usb-eth" [shape=ellipse, fillcolor="#fdf0e3", color="#ea580c", style="filled,dashed", tooltip="USB 3.0 gigabit dongle. `upstream.attached_to` is what joins it to the\nlaptop - there is deliberately no cable between the two (NG-X005).\n", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>adp-usb-eth</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[adapter]</TD></TR>
      <TR><TD ALIGN="LEFT">enx001122334455</TD><TD ALIGN="LEFT">192.168.10.30/24, 2001:db8:10::30/64</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>
  >];
  "hosts/laptop" [shape=rectangle, fillcolor="#f5f5f5", color="#6b7280", tooltip="Ultrabook without a built-in Ethernet port. It reaches the wired network\nthrough the USB dongle declared in hosts/adp-usb-eth.yaml, so it owns no\ncabled interface of its own.\n", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>laptop</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[computer]</TD></TR>
    </TABLE>
  >];
  "hosts/pc-desk" [shape=rectangle, fillcolor="#f5f5f5", color="#6b7280", tooltip="Desktop workstation in the study", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>pc-desk</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[computer]</TD></TR>
      <TR><TD ALIGN="LEFT">eno1</TD><TD ALIGN="LEFT">192.168.10.20/24, 2001:db8:10::20/64</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>
  >];
  "hosts/srv-nas" [shape=cylinder, fillcolor="#eae2f5", color="#7c3aed", tooltip="Backup and media server", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>srv-nas</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[server]</TD></TR>
      <TR><TD ALIGN="LEFT">eth0</TD><TD ALIGN="LEFT">192.168.10.10/24, 2001:db8:10::10/64</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>
  >];
  "routers/rtr-home" [shape=diamond, fillcolor="#dbe9f6", color="#2563eb", tooltip="Home edge router. Terminates the ISP hand-off on wan0 and is the default\ngateway for the single home VLAN (10).\n", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>rtr-home</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[router]</TD></TR>
      <TR><TD ALIGN="LEFT">lo0</TD><TD ALIGN="LEFT">192.0.2.1/32, 2001:db8::1/128</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">wan0</TD><TD ALIGN="LEFT">203.0.113.2/30</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">lan0</TD><TD ALIGN="LEFT">192.168.10.1/24, 2001:db8:10::1/64</TD><TD ALIGN="LEFT">vlan 10</TD></TR>
    </TABLE>
  >];
  "switches/sw-home" [shape=box3d, fillcolor="#dcf0dc", color="#16a34a", tooltip="Eight-port desktop switch in the hallway cabinet", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>sw-home</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[switch]</TD></TR>
      <TR><TD ALIGN="LEFT">Vlan10</TD><TD ALIGN="LEFT">192.168.10.2/24</TD><TD ALIGN="LEFT">vlan 10</TD></TR>
      <TR><TD ALIGN="LEFT">port1</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
      <TR><TD ALIGN="LEFT">port2</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
      <TR><TD ALIGN="LEFT">port3</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
      <TR><TD ALIGN="LEFT">port4</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
      <TR><TD ALIGN="LEFT">port5</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 10</TD></TR>
    </TABLE>
  >];

  "routers/rtr-home" -- "switches/sw-home" [color="#4a4a4a", style=solid, penwidth=1.5, label="lan0 -- port1\nvlan 10", tooltip="cable: cbl-rtr-sw, medium: copper, speed: 1Gbps, length: 0.5 m, vlans: 10"];
  "hosts/pc-desk" -- "switches/sw-home" [color="#4a4a4a", style=solid, penwidth=1.5, label="eno1 -- port2\nvlan 10", tooltip="cable: cbl-sw-desk, medium: copper, speed: 1Gbps, length: 8 m, vlans: 10"];
  "hosts/srv-nas" -- "switches/sw-home" [color="#4a4a4a", style=solid, penwidth=1.5, label="eth0 -- port3\nvlan 10", tooltip="cable: cbl-sw-nas, medium: copper, speed: 1Gbps, length: 0.5 m, vlans: 10"];
  "hosts/adp-usb-eth" -- "switches/sw-home" [color="#4a4a4a", style=solid, penwidth=1.5, label="enx001122334455 -- port4\nvlan 10", tooltip="cable: cbl-sw-dongle, medium: copper, speed: 1Gbps, length: 10 m, vlans: 10"];
  "hosts/laptop" -- "hosts/adp-usb-eth" [color="#9ca3af", style=dotted, penwidth=2.0, label="usb0\nusb", tooltip="attachment: adp-usb-eth, medium: copper, speed: 5Gbps"];
}
