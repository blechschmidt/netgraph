      <TR><TD COLSPAN="3" ALIGN="CENTER">[switch]</TD></TR>
    </TABLE>
  >];
  "sites/south/access/sw-south-acc-02" [shape=box3d, fillcolor="#dcf0dc", color="#16a34a", tooltip="Access switch 02, South campus - second floor riser.", label=<
