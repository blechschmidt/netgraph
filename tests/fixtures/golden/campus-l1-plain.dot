  "sites/south/hosts/srv-south-01" -- "sites/south/access/sw-south-acc-01" [color="#4a4a4a", style=solid, penwidth=1.5, label="eth0 -- GigabitEthernet1/0/2\nC-202\n1Gbps", tooltip="cable: cbl-south-acc01-srv01, medium: copper, speed: 1Gbps, length: 6 m"];
