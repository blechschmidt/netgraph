  "sites/north/core/rtr-north-core-01" -- "sites/south/core/rtr-south-core-01" [color="#d97706", style=bold, penwidth=2.5, label="xe-0/0/1 -- xe-0/0/2\nBB-NS\nfiber\n10Gbps", tooltip="cable: cbl-bb-north-south, medium: fiber, speed: 10Gbps, length: 4200 m"];
  "sites/south/core/rtr-south-core-01" -- "sites/west/core/rtr-west-core-01" [color="#d97706", style=bold, penwidth=2.5, label="xe-0/0/1 -- xe-0/0/2\nBB-SW\nfiber\n10Gbps", tooltip="cable: cbl-bb-south-west, medium: fiber, speed: 10Gbps, length: 4200 m"];
  "sites/north/core/rtr-north-core-01" -- "sites/west/core/rtr-west-core-01" [color="#d97706", style=bold, penwidth=2.5, label="xe-0/0/2 -- xe-0/0/1\nBB-WN\nfiber\n10Gbps", tooltip="cable: cbl-bb-west-north, medium: fiber, speed: 10Gbps, length: 4200 m"];
  "sites/north/core/rtr-north-core-01" -- "sites/north/distribution/sw-north-dist-01" [color="#d97706", style=bold, penwidth=2.5, label="xe-0/0/0 -- Ethernet52/1\nF-101\nfiber\n10Gbps", tooltip="cable: cbl-north-core-dist, medium: fiber, speed: 10Gbps, length: 12 m"];
