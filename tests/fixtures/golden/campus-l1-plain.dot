  "sites/north/access/sw-north-acc-02" -- "sites/north/distribution/sw-north-dist-01" [color="#d97706", style=bold, penwidth=2.5, label="TenGigabitEthernet1/1/1 -- Ethernet50/1\nF-103\nfiber\n10Gbps", tooltip="cable: cbl-north-dist-acc02, medium: fiber, speed: 10Gbps, length: 78 m"];
  "sites/north/hosts/pc-north-01" -- "sites/north/access/sw-north-acc-01" [color="#4a4a4a", style=solid, penwidth=1.5, label="eno1 -- GigabitEthernet1/0/1\nC-101\n1Gbps", tooltip="cable: cbl-north-acc01-pc01, medium: copper, speed: 1Gbps, length: 22 m"];
