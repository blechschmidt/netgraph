      <TR><TD COLSPAN="3" ALIGN="CENTER">[server]</TD></TR>
    </TABLE>
  >];
  "sites/south/hosts/pc-south-02" [shape=rectangle, fillcolor="#f5f5f5", color="#6b7280", tooltip="Staff workstation, South campus floor 2", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>pc-south-02</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[computer]</TD></TR>
    </TABLE>
  >];
  "sites/west/access/sw-west-acc-01" [shape=box3d, fillcolor="#dcf0dc", color="#16a34a", tooltip="Access switch 01, West annexe. Layer-2 only: the ports are untagged access\nports, and the switch's own management address lives on the Vlan99 SVI\nrather than on a port (NG-V009).\n", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>sw-west-acc-01</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[switch]</TD></TR>
    </TABLE>
  >];
  "sites/west/access/sw-west-acc-02" [shape=box3d, fillcolor="#dcf0dc", color="#16a34a", tooltip="Access switch 02, West annexe - second floor riser.", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>sw-west-acc-02</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[switch]</TD></TR>
    </TABLE>
  >];
  "sites/west/core/rtr-west-core-01" [shape=diamond, fillcolor="#dbe9f6", color="#2563eb", tooltip="Layer-3 core router for the West annexe. It routes between the campus VLANs\n(whose gateways sit on sw-west-dist-01) and carries the two backbone\nfibres of the inter-site ring.\n", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>rtr-west-core-01</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[router]</TD></TR>
    </TABLE>
  >];
  "sites/west/distribution/sw-west-dist-01" [shape=box3d, fillcolor="#dcf0dc", color="#16a34a", tooltip="Distribution switch for the West annexe. It aggregates the access-layer\ntrunks, hosts the SVI gateway for every campus VLAN, and reaches the core\nrouter over a routed (untagged) fibre uplink.\n", label=<
