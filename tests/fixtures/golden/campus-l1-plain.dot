graph netgraph {
  graph [
    rankdir=TB,
    splines=true,
    overlap=false,
    nodesep=0.5,
    ranksep=0.7,
    fontname="Helvetica,Arial,sans-serif",
    fontsize=12,
  ];
  node [fontname="Helvetica,Arial,sans-serif", fontsize=10, style=filled, penwidth=1.2];
  edge [fontname="Helvetica,Arial,sans-serif", fontsize=8];

  "sites/north/access/sw-north-acc-01" [shape=box3d, fillcolor="#dcf0dc", color="#16a34a", tooltip="sw-north-acc-01 [switch]\nnamespace: sites/north/access\nAccess switch 01, North campus. Layer-2 only: the ports are untagged access ports, and the switch's own management address lives on the Vlan99 SVI rather than on a port (NG-V009).\nlabels: env=prod, role=access, site=north\ninterfaces (6):\n  br0  bridge\n  Vlan99  vlan\n  GigabitEthernet1/0/1  ethernet  00:1b:0d:01:a1:01\n  GigabitEthernet1/0/2  ethernet  00:1b:0d:01:a1:02\n  GigabitEthernet1/0/3  ethernet  disabled  00:1b:0d:01:a1:03\n  TenGigabitEthernet1/1/1  ethernet  00:1b:0d:01:a1:11\nlinks (3):\n  TenGigabitEthernet1/1/1 — sites/north/distribution/sw-north-dist-01:Ethernet49/1  (cable, fiber, 10Gbps)\n  GigabitEthernet1/0/1 — sites/north/hosts/pc-north-01:eno1  (cable, copper, 1Gbps)\n  GigabitEthernet1/0/2 — sites/north/hosts/srv-north-01:eth0  (cable, copper, 1Gbps)", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>sw-north-acc-01</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[switch]</TD></TR>
    </TABLE>
  >];
  "sites/north/access/sw-north-acc-02" [shape=box3d, fillcolor="#dcf0dc", color="#16a34a", tooltip="sw-north-acc-02 [switch]\nnamespace: sites/north/access\nAccess switch 02, North campus - second floor riser.\nlabels: env=prod, role=access, site=north\ninterfaces (5):\n  br0  bridge\n  Vlan99  vlan\n  GigabitEthernet1/0/1  ethernet  00:1b:0d:01:a2:01\n  GigabitEthernet1/0/2  ethernet  disabled  00:1b:0d:01:a2:02\n  TenGigabitEthernet1/1/1  ethernet  00:1b:0d:01:a2:11\nlinks (2):\n  TenGigabitEthernet1/1/1 — sites/north/distribution/sw-north-dist-01:Ethernet50/1  (cable, fiber, 10Gbps)\n  GigabitEthernet1/0/1 — sites/north/hosts/pc-north-02:eno1  (cable, copper, 1Gbps)", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>sw-north-acc-02</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[switch]</TD></TR>
    </TABLE>
  >];
  "sites/north/access/sw-north-acc-03" [shape=box3d, fillcolor="#dcf0dc", color="#16a34a", tooltip="sw-north-acc-03 [switch]\nnamespace: sites/north/access\nAccess switch 03, North campus - third floor riser.\nlabels: env=prod, role=access, site=north\ninterfaces (51):\n  br0  bridge\n  Vlan99  vlan\n  GigabitEthernet1/0/1  ethernet  disabled\n  GigabitEthernet1/0/2  ethernet  disabled\n  GigabitEthernet1/0/3  ethernet  disabled\n  GigabitEthernet1/0/4  ethernet  disabled\n  GigabitEthernet1/0/5  ethernet  disabled\n  GigabitEthernet1/0/6  ethernet  disabled\n  (+43 more)\nlinks (1):\n  TenGigabitEthernet1/1/1 — sites/north/distribution/sw-north-dist-01:Ethernet51/1  (cable, fiber, 10Gbps)", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>sw-north-acc-03</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[switch]</TD></TR>
    </TABLE>
  >];
  "sites/north/core/rtr-north-core-01" [shape=diamond, fillcolor="#dbe9f6", color="#2563eb", tooltip="rtr-north-core-01 [router]\nnamespace: sites/north/core\nLayer-3 core router for the North campus. It routes between the campus VLANs (whose gateways sit on sw-north-dist-01) and carries the two backbone fibres of the inter-site ring.\nlabels: env=prod, role=core, site=north\ninterfaces (4):\n  lo0  loopback\n  xe-0/0/0  ethernet  00:05:86:01:c0:00\n  xe-0/0/1  ethernet  00:05:86:01:c0:01\n  xe-0/0/2  ethernet  00:05:86:01:c0:02\nlinks (3):\n  xe-0/0/1 — sites/south/core/rtr-south-core-01:xe-0/0/2  (cable, fiber, 10Gbps)\n  xe-0/0/2 — sites/west/core/rtr-west-core-01:xe-0/0/1  (cable, fiber, 10Gbps)\n  xe-0/0/0 — sites/north/distribution/sw-north-dist-01:Ethernet52/1  (cable, fiber, 10Gbps)", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>rtr-north-core-01</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[router]</TD></TR>
    </TABLE>
  >];
  "sites/north/distribution/sw-north-dist-01" [shape=box3d, fillcolor="#dcf0dc", color="#16a34a", tooltip="sw-north-dist-01 [switch]\nnamespace: sites/north/distribution\nDistribution switch for the North campus. It aggregates the access-layer trunks, hosts the SVI gateway for every campus VLAN, and reaches the core router over a routed (untagged) fibre uplink.\nlabels: env=prod, role=distribution, site=north\ninterfaces (8):\n  br0  bridge\n  Vlan10  vlan\n  Vlan20  vlan\n  Vlan99  vlan\n  Ethernet49/1  ethernet  00:1c:73:01:d0:01\n  Ethernet50/1  ethernet  00:1c:73:01:d0:02\n  Ethernet51/1  ethernet  00:1c:73:01:d0:03\n  Ethernet52/1  ethernet  00:1c:73:01:d0:04\nlinks (4):\n  Ethernet52/1 — sites/north/core/rtr-north-core-01:xe-0/0/0  (cable, fiber, 10Gbps)\n  Ethernet49/1 — sites/north/access/sw-north-acc-01:TenGigabitEthernet1/1/1  (cable, fiber, 10Gbps)\n  Ethernet50/1 — sites/north/access/sw-north-acc-02:TenGigabitEthernet1/1/1  (cable, fiber, 10Gbps)\n  Ethernet51/1 — sites/north/access/sw-north-acc-03:TenGigabitEthernet1/1/1  (cable, fiber, 10Gbps)", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>sw-north-dist-01</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[switch]</TD></TR>
    </TABLE>
  >];
  "sites/north/hosts/pc-north-01" [shape=rectangle, fillcolor="#f5f5f5", color="#6b7280", tooltip="pc-north-01 [computer]\nnamespace: sites/north/hosts\nStaff workstation, North campus floor 1\nlabels: env=prod, role=workstation, site=north\ninterfaces (2):\n  lo  loopback\n  eno1  ethernet  b4:96:91:01:10:01\nlinks (1):\n  eno1 — sites/north/access/sw-north-acc-01:GigabitEthernet1/0/1  (cable, copper, 1Gbps)", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>pc-north-01</B></TD></TR>
