graph netgraph {
  graph [
    rankdir=TB,
    splines=true,
    overlap=false,
    nodesep=0.5,
    ranksep=0.7,
    fontname="Helvetica,Arial,sans-serif",
    fontsize=12,
  ];
  node [fontname="Helvetica,Arial,sans-serif", fontsize=10, style=filled, penwidth=1.2];
  edge [fontname="Helvetica,Arial,sans-serif", fontsize=8];

  "sites/north/access/sw-north-acc-01" [shape=box3d, fillcolor="#dcf0dc", color="#16a34a", tooltip="Access switch 01, North campus. Layer-2 only: the ports are untagged access\nports, and the switch's own management address lives on the Vlan99 SVI\nrather than on a port (NG-V009).\n", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>sw-north-acc-01</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[switch]</TD></TR>
    </TABLE>
  >];
  "sites/north/access/sw-north-acc-02" [shape=box3d, fillcolor="#dcf0dc", color="#16a34a", tooltip="Access switch 02, North campus - second floor riser.", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>sw-north-acc-02</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[switch]</TD></TR>
    </TABLE>
  >];
  "sites/north/core/rtr-north-core-01" [shape=diamond, fillcolor="#dbe9f6", color="#2563eb", tooltip="Layer-3 core router for the North campus. It routes between the campus VLANs\n(whose gateways sit on sw-north-dist-01) and carries the two backbone\nfibres of the inter-site ring.\n", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>rtr-north-core-01</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[router]</TD></TR>
    </TABLE>
  >];
  "sites/north/distribution/sw-north-dist-01" [shape=box3d, fillcolor="#dcf0dc", color="#16a34a", tooltip="Distribution switch for the North campus. It aggregates the access-layer\ntrunks, hosts the SVI gateway for every campus VLAN, and reaches the core\nrouter over a routed (untagged) fibre uplink.\n", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>sw-north-dist-01</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[switch]</TD></TR>
    </TABLE>
  >];
  "sites/north/hosts/pc-north-01" [shape=rectangle, fillcolor="#f5f5f5", color="#6b7280", tooltip="Staff workstation, North campus floor 1", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>pc-north-01</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[computer]</TD></TR>
    </TABLE>
  >];
  "sites/north/hosts/srv-north-01" [shape=cylinder, fillcolor="#eae2f5", color="#7c3aed", tooltip="Teaching-lab application server, North campus", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>srv-north-01</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[server]</TD></TR>
    </TABLE>
  >];
  "sites/north/hosts/pc-north-02" [shape=rectangle, fillcolor="#f5f5f5", color="#6b7280", tooltip="Staff workstation, North campus floor 2", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>pc-north-02</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[computer]</TD></TR>
    </TABLE>
  >];
  "sites/south/access/sw-south-acc-01" [shape=box3d, fillcolor="#dcf0dc", color="#16a34a", tooltip="Access switch 01, South campus. Layer-2 only: the ports are untagged access\nports, and the switch's own management address lives on the Vlan99 SVI\nrather than on a port (NG-V009).\n", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
