  "sites/south/core/rtr-south-core-01" -- "sites/south/distribution/sw-south-dist-01" [color="#d97706", style=bold, penwidth=2.5, label="xe-0/0/0 -- Ethernet52/1\nF-201\nfiber\n10Gbps", tooltip="cable: cbl-south-core-dist, medium: fiber, speed: 10Gbps, length: 12 m"];
