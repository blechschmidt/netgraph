        {
          "name": "ge-0/0/0",
          "type": "ethernet",
          "description": "Routed link to sw-core-01. No 'vlan' block: this port is a layer-3\ninterface, not a bridge port.\n",
          "mac": "00:05:86:0a:00:00",
          "mtu": 1500,
          "addresses": [
            "10.0.0.1/30"
