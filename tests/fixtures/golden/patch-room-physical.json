    {
      "id": "network/sw-access-01",
      "type": "element",
      "name": "sw-access-01",
      "kind": "switch",
      "namespace": "network",
      "description": "PoE access switch in rack r2. Its uplink leaves the rack through the panel\nabove it, exactly as the server links do; its two PoE ports feed a ceiling\naccess point and a lobby camera, neither of which has a power cord.\n\nThe switch itself is dual-corded: 'psu1' to the A-side strip, 'psu2' to the\nB-side one. Both strips are in this rack, and they are on different input\nfeeds, which is what makes 'redundant: true' true (NG-E015).\n",
      "labels": {
        "env": "prod",
        "role": "access",
        "site": "hq"
      },
      "vlans": [
        10
      ],
      "interfaces": [
        {
          "name": "br0",
          "type": "bridge",
          "description": "Switching instance"
        },
        {
          "name": "Vlan10",
          "type": "vlan",
          "description": "In-band management address of the access switch",
          "addresses": [
            "10.10.0.3/24"
          ],
          "vlan": {
            "mode": "access",
            "vlans": [
              10
            ]
          }
        },
        {
          "name": "GigabitEthernet1/0/1",
          "type": "ethernet",
          "description": "ap-ceiling-01, patched through pp-r2-a position 9. The class-4\nreservation is what the 802.3at PSE takes out of the 370 W pool for\nthis port.\n",
          "mac": "00:1b:0d:0b:00:01",
          "mtu": 1500,
          "vlan": {
            "mode": "access",
            "vlans": [
              10
            ]
          }
        },
