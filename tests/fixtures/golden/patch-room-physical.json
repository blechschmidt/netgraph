    {
      "id": "hosts/ap-ceiling-01",
      "type": "element",
      "name": "ap-ceiling-01",
      "kind": "switch",
      "namespace": "hosts",
      "description": "Ceiling access point above the machine room, powered over its uplink:\n'powered_by: poe' says the run carrying its traffic is its only power path,\nso it declares no 'power.inputs' at all. The far end of that run is\nsw-access-01:GigabitEthernet1/0/1, reached across pp-r2-a — a run through a\npanel is electrically one run for power exactly as it is for frames.\n",
      "labels": {
        "env": "prod",
        "role": "wireless",
        "site": "hq"
      },
      "vlans": [
        10
      ],
      "interfaces": [
        {
          "name": "br0",
          "type": "bridge",
          "description": "Bridges the radio onto the wired uplink"
        },
        {
          "name": "Vlan10",
          "type": "vlan",
          "description": "In-band management address of the access point",
          "addresses": [
            "10.10.0.4/24"
          ],
          "vlan": {
            "mode": "access",
            "vlans": [
              10
            ]
          }
        },
        {
          "name": "eth0",
          "type": "ethernet",
          "description": "PoE uplink, patched through pp-r2-a position 9",
          "mac": "70:69:5a:0c:00:01",
          "mtu": 1500,
          "vlan": {
            "mode": "access",
            "vlans": [
              10
            ]
          }
        },
        {
          "name": "wlan0",
          "type": "wifi",
          "description": "5 GHz radio, one SSID",
          "mac": "70:69:5a:0c:00:10",
          "mtu": 1500
        }
      ],
