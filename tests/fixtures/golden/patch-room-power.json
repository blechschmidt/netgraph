      "id": "network/sw-access-01",
      "type": "element",
      "name": "sw-access-01",
      "kind": "switch",
      "namespace": "network",
      "description": "PoE access switch in rack r2. Its uplink leaves the rack through the panel\nabove it, exactly as the server links do; its two PoE ports feed a ceiling\naccess point and a lobby camera, neither of which has a power cord.\n\nThe switch itself is dual-corded: 'psu1' to the A-side strip, 'psu2' to the\nB-side one. Both strips are in this rack, and they are on different input\nfeeds, which is what makes 'redundant: true' true (NV-E015).\n",
      "labels": {
        "env": "prod",
        "role": "access",
        "site": "hq"
      },
      "power": {
        "roles": [
          "pse",
          "load"
        ],
        "drawWatts": 55.0,
        "maximumWatts": 435.0,
        "poeBudgetWatts": 370.0,
        "poeAllocatedWatts": 37.0,
        "inputs": 2,
        "redundant": true,
        "utilisation": 0.1
      },
