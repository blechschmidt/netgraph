graph netviz {
  graph [
    rankdir=TB,
    splines=true,
    overlap=false,
    nodesep=0.5,
    ranksep=0.7,
    fontname="Helvetica,Arial,sans-serif",
    fontsize=12,
    label="Overlay, layer 2",
    labelloc=t,
    fontsize=16,
  ];
  node [fontname="Helvetica,Arial,sans-serif", fontsize=10, style=filled, penwidth=1.2];
  edge [fontname="Helvetica,Arial,sans-serif", fontsize=8];

  "sites/branch-a/pc-branch-a" [shape=rectangle, fillcolor="#f5f5f5", color="#6b7280", tooltip="pc-branch-a [computer]\nnamespace: sites/branch-a\nWorkstation, Branch A.\nlabels: site=branch-a\ninterfaces (1):\n  enp3s0  ethernet  10.20.0.10/24\nlinks (1):\n  enp3s0 — sites/branch-a/rtr-branch-a:ether2  (cable, copper, 1Gbps)", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>pc-branch-a</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[computer]</TD></TR>
      <TR><TD ALIGN="LEFT">enp3s0</TD><TD ALIGN="LEFT">10.20.0.10/24</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>
  >];
  "sites/branch-a/rtr-branch-a" [shape=diamond, fillcolor="#dbe9f6", color="#2563eb", tooltip="rtr-branch-a [router]\nnamespace: sites/branch-a\nBranch A edge router. Mesh member only.\nlabels: role=edge, site=branch-a\ninterfaces (3):\n  ether1  ethernet  198.51.100.6/30\n  ether2  ethernet  10.20.0.1/24\n  wg0  tunnel  10.255.0.2/24\nlinks (3):\n  ether2 — sites/branch-a/pc-branch-a:enp3s0  (cable, copper, 1Gbps)\n  ether1 — wan/wan-core:ge-0/0/1  (cable, fiber, 1Gbps)\n  wg0 — tunnel:tunnels/wg-mesh  (tunnel, wireguard)", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>rtr-branch-a</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[router]</TD></TR>
      <TR><TD ALIGN="LEFT">ether1</TD><TD ALIGN="LEFT">198.51.100.6/30</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">ether2</TD><TD ALIGN="LEFT">10.20.0.1/24</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">wg0</TD><TD ALIGN="LEFT">10.255.0.2/24</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>
  >];
  "sites/branch-b/pc-branch-b" [shape=rectangle, fillcolor="#f5f5f5", color="#6b7280", tooltip="pc-branch-b [computer]\nnamespace: sites/branch-b\nAdministrator's workstation. Dials into HQ over OpenVPN.\nlabels: site=branch-b\ninterfaces (2):\n  enp3s0  ethernet  10.30.0.10/24\n  tun0  tunnel  10.253.0.10/24\nlinks (2):\n  enp3s0 — sites/branch-b/rtr-branch-b:ether2  (cable, copper, 1Gbps)\n  tun0 — sites/hq/rtr-hq:ovpn0  (tunnel, openvpn)", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>pc-branch-b</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[computer]</TD></TR>
      <TR><TD ALIGN="LEFT">enp3s0</TD><TD ALIGN="LEFT">10.30.0.10/24</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">tun0</TD><TD ALIGN="LEFT">10.253.0.10/24</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>
  >];
  "sites/branch-b/rtr-branch-b" [shape=diamond, fillcolor="#dbe9f6", color="#2563eb", tooltip="rtr-branch-b [router]\nnamespace: sites/branch-b\nBranch B edge router. Mesh member, and the far end of the IPsec stack.\nlabels: role=edge, site=branch-b\nvlans: 100\ninterfaces (6):\n  ether1  ethernet  198.51.100.10/30\n  ether2  ethernet  10.30.0.1/24\n  wg0  tunnel  10.255.0.3/24\n  ipsec0  tunnel  10.254.0.2/30\n  vxlan100  tunnel  vlan 100 (access)\n  gre1  tunnel  10.252.0.2/30\nlinks (6):\n  ether2 — sites/branch-b/pc-branch-b:enp3s0  (cable, copper, 1Gbps)\n  ether1 — wan/wan-core:ge-0/0/2  (cable, fiber, 1Gbps)\n  wg0 — tunnel:tunnels/wg-mesh  (tunnel, wireguard)\n  ipsec0 — sites/hq/rtr-hq:ipsec0  (tunnel, ipsec)\n  vxlan100 — sites/hq/rtr-hq:vxlan100  (tunnel, vxlan over ipsec)  vlan 100\n  gre1 — sites/hq/rtr-hq:gre1  (tunnel, gre over ipsec)", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>rtr-branch-b</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[router]</TD></TR>
      <TR><TD ALIGN="LEFT">ether1</TD><TD ALIGN="LEFT">198.51.100.10/30</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">ether2</TD><TD ALIGN="LEFT">10.30.0.1/24</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">wg0</TD><TD ALIGN="LEFT">10.255.0.3/24</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">ipsec0</TD><TD ALIGN="LEFT">10.254.0.2/30</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">vxlan100</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 100</TD></TR>
      <TR><TD ALIGN="LEFT">gre1</TD><TD ALIGN="LEFT">10.252.0.2/30</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>
  >];
  "sites/hq/rtr-hq" [shape=diamond, fillcolor="#dbe9f6", color="#2563eb", tooltip="rtr-hq [router]\nnamespace: sites/hq\nHQ edge router and overlay hub.\nlabels: role=edge, site=hq\nvlans: 100\ninterfaces (7):\n  eth0  ethernet  198.51.100.2/30\n  eth1  ethernet  10.10.0.1/24\n  wg0  tunnel  10.255.0.1/24\n  ipsec0  tunnel  10.254.0.1/30\n  vxlan100  tunnel  vlan 100 (access)\n  gre1  tunnel  10.252.0.1/30\n  ovpn0  tunnel  10.253.0.1/24\nlinks (7):\n  eth1 — sites/hq/srv-hq:eno1  (cable, copper, 1Gbps)\n  eth0 — wan/wan-core:ge-0/0/0  (cable, fiber, 1Gbps)\n  wg0 — tunnel:tunnels/wg-mesh  (tunnel, wireguard)\n  ipsec0 — sites/branch-b/rtr-branch-b:ipsec0  (tunnel, ipsec)\n  vxlan100 — sites/branch-b/rtr-branch-b:vxlan100  (tunnel, vxlan over ipsec)  vlan 100\n  gre1 — sites/branch-b/rtr-branch-b:gre1  (tunnel, gre over ipsec)\n  ovpn0 — sites/branch-b/pc-branch-b:tun0  (tunnel, openvpn)", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>rtr-hq</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[router]</TD></TR>
      <TR><TD ALIGN="LEFT">eth0</TD><TD ALIGN="LEFT">198.51.100.2/30</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">eth1</TD><TD ALIGN="LEFT">10.10.0.1/24</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">wg0</TD><TD ALIGN="LEFT">10.255.0.1/24</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">ipsec0</TD><TD ALIGN="LEFT">10.254.0.1/30</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">vxlan100</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vlan 100</TD></TR>
      <TR><TD ALIGN="LEFT">gre1</TD><TD ALIGN="LEFT">10.252.0.1/30</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">ovpn0</TD><TD ALIGN="LEFT">10.253.0.1/24</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>
  >];
  "sites/hq/srv-hq" [shape=cylinder, fillcolor="#eae2f5", color="#7c3aed", tooltip="srv-hq [server]\nnamespace: sites/hq\nFile server, HQ.\nlabels: site=hq\ninterfaces (1):\n  eno1  ethernet  10.10.0.10/24\nlinks (1):\n  eno1 — sites/hq/rtr-hq:eth1  (cable, copper, 1Gbps)", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>srv-hq</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[server]</TD></TR>
      <TR><TD ALIGN="LEFT">eno1</TD><TD ALIGN="LEFT">10.10.0.10/24</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>
  >];
  "wan/wan-core" [shape=diamond, fillcolor="#dbe9f6", color="#2563eb", tooltip="wan-core [router]\nnamespace: wan\nProvider edge. Three /30 hand-offs, one per site.\nlabels: role=wan\ninterfaces (3):\n  ge-0/0/0  ethernet  198.51.100.1/30\n  ge-0/0/1  ethernet  198.51.100.5/30\n  ge-0/0/2  ethernet  198.51.100.9/30\nlinks (3):\n  ge-0/0/0 — sites/hq/rtr-hq:eth0  (cable, fiber, 1Gbps)\n  ge-0/0/1 — sites/branch-a/rtr-branch-a:ether1  (cable, fiber, 1Gbps)\n  ge-0/0/2 — sites/branch-b/rtr-branch-b:ether1  (cable, fiber, 1Gbps)", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>wan-core</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[router]</TD></TR>
      <TR><TD ALIGN="LEFT">ge-0/0/0</TD><TD ALIGN="LEFT">198.51.100.1/30</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">ge-0/0/1</TD><TD ALIGN="LEFT">198.51.100.5/30</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">ge-0/0/2</TD><TD ALIGN="LEFT">198.51.100.9/30</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>
  >];
  "tunnel:tunnels/wg-mesh" [shape=hexagon, fillcolor="#ede9fe", color="#6d28d9", style="filled,dashed", tooltip="wg-mesh [wireguard tunnel]\nnamespace: tunnels\nFull mesh between the three sites.\nlabels: role=transit\nstack: wireguard\ntransport udp/51820, encrypted: chacha20-poly1305, auth public-key, mtu 1420 (overhead 80 B)\nendpoints (3):\n  sites/branch-a/rtr-branch-a:wg0\n  sites/branch-b/rtr-branch-b:wg0\n  sites/hq/rtr-hq:wg0\nlinks (3):\n  sites/branch-a/rtr-branch-a:wg0  (tunnel, wireguard)\n  sites/branch-b/rtr-branch-b:wg0  (tunnel, wireguard)\n  sites/hq/rtr-hq:wg0  (tunnel, wireguard)", label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
      <TR><TD COLSPAN="3" ALIGN="CENTER"><B>wg-mesh</B></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">[wireguard tunnel]</TD></TR>
      <TR><TD ALIGN="LEFT">rtr-branch-a</TD><TD ALIGN="LEFT">wg0</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">rtr-branch-b</TD><TD ALIGN="LEFT">wg0</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">rtr-hq</TD><TD ALIGN="LEFT">wg0</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD COLSPAN="3" ALIGN="CENTER">mtu 1420</TD></TR>
    </TABLE>
  >];

  "sites/hq/rtr-hq" -- "sites/hq/srv-hq" [color="#4a4a4a", style=solid, penwidth=1.5, label="eth1 -- eno1", tooltip="cable cables/cbl-hq-srv\nsites/hq/rtr-hq:eth1 — sites/hq/srv-hq:eno1\nmedium: copper, speed: 1Gbps"];
  "sites/branch-a/pc-branch-a" -- "sites/branch-a/rtr-branch-a" [color="#4a4a4a", style=solid, penwidth=1.5, label="enp3s0 -- ether2", tooltip="cable cables/cbl-branch-a-pc\nsites/branch-a/pc-branch-a:enp3s0 — sites/branch-a/rtr-branch-a:ether2\nmedium: copper, speed: 1Gbps"];
  "sites/branch-b/pc-branch-b" -- "sites/branch-b/rtr-branch-b" [color="#4a4a4a", style=solid, penwidth=1.5, label="enp3s0 -- ether2", tooltip="cable cables/cbl-branch-b-pc\nsites/branch-b/pc-branch-b:enp3s0 — sites/branch-b/rtr-branch-b:ether2\nmedium: copper, speed: 1Gbps"];
  "sites/hq/rtr-hq" -- "wan/wan-core" [color="#d97706", style=bold, penwidth=1.5, label="eth0 -- ge-0/0/0", tooltip="cable cables/cbl-wan-hq\nsites/hq/rtr-hq:eth0 — wan/wan-core:ge-0/0/0\nmedium: fiber, speed: 1Gbps, label: PE-01"];
  "sites/branch-a/rtr-branch-a" -- "wan/wan-core" [color="#d97706", style=bold, penwidth=1.5, label="ether1 -- ge-0/0/1", tooltip="cable cables/cbl-wan-branch-a\nsites/branch-a/rtr-branch-a:ether1 — wan/wan-core:ge-0/0/1\nmedium: fiber, speed: 1Gbps, label: PE-02"];
  "sites/branch-b/rtr-branch-b" -- "wan/wan-core" [color="#d97706", style=bold, penwidth=1.5, label="ether1 -- ge-0/0/2", tooltip="cable cables/cbl-wan-branch-b\nsites/branch-b/rtr-branch-b:ether1 — wan/wan-core:ge-0/0/2\nmedium: fiber, speed: 1Gbps, label: PE-03"];
  "sites/branch-a/rtr-branch-a" -- "tunnel:tunnels/wg-mesh" [color="#6d28d9", style=dashed, label="wg0\nwireguard\nMESH", tooltip="tunnel tunnels/wg-mesh#sites/branch-a/rtr-branch-a:wg0\nsites/branch-a/rtr-branch-a:wg0 — tunnel:tunnels/wg-mesh\nstack: wireguard\ntransport udp/51820, encrypted: chacha20-poly1305, auth public-key, mtu 1420 (overhead 80 B)\nendpoints (3):\n  sites/branch-a/rtr-branch-a:wg0\n  sites/branch-b/rtr-branch-b:wg0\n  sites/hq/rtr-hq:wg0"];
  "sites/branch-b/rtr-branch-b" -- "tunnel:tunnels/wg-mesh" [color="#6d28d9", style=dashed, label="wg0\nwireguard\nMESH", tooltip="tunnel tunnels/wg-mesh#sites/branch-b/rtr-branch-b:wg0\nsites/branch-b/rtr-branch-b:wg0 — tunnel:tunnels/wg-mesh\nstack: wireguard\ntransport udp/51820, encrypted: chacha20-poly1305, auth public-key, mtu 1420 (overhead 80 B)\nendpoints (3):\n  sites/branch-a/rtr-branch-a:wg0\n  sites/branch-b/rtr-branch-b:wg0\n  sites/hq/rtr-hq:wg0"];
  "sites/hq/rtr-hq" -- "tunnel:tunnels/wg-mesh" [color="#6d28d9", style=dashed, label="wg0\nwireguard\nMESH", tooltip="tunnel tunnels/wg-mesh#sites/hq/rtr-hq:wg0\nsites/hq/rtr-hq:wg0 — tunnel:tunnels/wg-mesh\nstack: wireguard\ntransport udp/51820, encrypted: chacha20-poly1305, auth public-key, mtu 1420 (overhead 80 B)\nendpoints (3):\n  sites/branch-a/rtr-branch-a:wg0\n  sites/branch-b/rtr-branch-b:wg0\n  sites/hq/rtr-hq:wg0"];
  "sites/branch-b/rtr-branch-b" -- "sites/hq/rtr-hq" [color="#6d28d9", style=dashed, label="ipsec0 -- ipsec0\nipsec", tooltip="tunnel tunnels/ipsec-hq-b\nsites/branch-b/rtr-branch-b:ipsec0 — sites/hq/rtr-hq:ipsec0\nstack: ipsec\nmode tunnel, transport esp, encrypted: aes-256-gcm, auth certificate, mtu 1427 (overhead 73 B)\nendpoints (2):\n  sites/branch-b/rtr-branch-b:ipsec0\n  sites/hq/rtr-hq:ipsec0"];
  "sites/branch-b/rtr-branch-b" -- "sites/hq/rtr-hq" [color="#6d28d9", style=dashed, label="vxlan100 -- vxlan100\nvxlan over ipsec\nvni 100\nvia encrypted underlay\nvlan 100", tooltip="tunnel tunnels/vx-100\nsites/branch-b/rtr-branch-b:vxlan100 — sites/hq/rtr-hq:vxlan100\nstack: vxlan over ipsec\nvni 100, transport udp/4789, cleartext, carried by tunnels/ipsec-hq-b, mtu 1377 (overhead 123 B)\nendpoints (2):\n  sites/branch-b/rtr-branch-b:vxlan100\n  sites/hq/rtr-hq:vxlan100\nvlans: 100"];
  "sites/branch-b/rtr-branch-b" -- "sites/hq/rtr-hq" [color="#6d28d9", style=dashed, label="gre1 -- gre1\ngre over ipsec\nvia encrypted underlay", tooltip="tunnel tunnels/gre-mgmt\nsites/branch-b/rtr-branch-b:gre1 — sites/hq/rtr-hq:gre1\nstack: gre over ipsec\ntransport gre, cleartext, carried by tunnels/ipsec-hq-b, mtu 1403 (overhead 97 B)\nendpoints (2):\n  sites/branch-b/rtr-branch-b:gre1\n  sites/hq/rtr-hq:gre1"];
  "sites/branch-b/pc-branch-b" -- "sites/hq/rtr-hq" [color="#6d28d9", style=dashed, label="tun0 -- ovpn0\nopenvpn", tooltip="tunnel tunnels/ovpn-admin\nsites/branch-b/pc-branch-b:tun0 — sites/hq/rtr-hq:ovpn0\nstack: openvpn\ntransport udp/1194, encrypted: aes-256-gcm, auth certificate, mtu 1431 (overhead 69 B)\nendpoints (2):\n  sites/branch-b/pc-branch-b:tun0\n  sites/hq/rtr-hq:ovpn0"];
}
