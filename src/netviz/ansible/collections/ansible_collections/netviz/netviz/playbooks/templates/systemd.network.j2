{# One systemd-networkd unit, from the netviz inventory. systemd.network(5). #}
# Generated by netviz.netviz.systemd_network from {{ netviz_element | default(inventory_hostname) }}.
# The inventory is the source of truth: edit the YAML, not this file.

[Match]
Name={{ item.name }}

[Network]
{% for address in item.addresses %}
Address={{ address }}
{% endfor %}
{% if netviz_gateway is defined and netviz_gateway %}
Gateway={{ netviz_gateway | netviz.netviz.host }}
{% endif %}
{% if item.vlans %}
# VLANs the inventory puts on this port: {{ item.vlans | join(', ') }}
{% endif %}

[Link]
{% if item.mtu %}
MTUBytes={{ item.mtu }}
{% endif %}
RequiredForOnline=yes
