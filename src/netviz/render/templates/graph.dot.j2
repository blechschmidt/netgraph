{#-
  Graphviz DOT document.

  Escaping contract — read this before adding a variable
  ------------------------------------------------------
  The environment renders with ``autoescape=True``, so a bare ``{{ value }}``
  is HTML-escaped. That is the correct escaping for the *inside* of an
  HTML-like label (``label=<...>``), which is where every free-form string in
  this template goes: Graphviz's HTML parser reads ``&amp;``, ``&lt;``,
  ``&gt;``, ``&#34;`` and ``&#39;`` and renders the literal characters, so an
  inventory name cannot close a ``<TD>`` or the label itself.

  The other context is a DOT quoted string — node ids, element ids, tooltips,
  URLs, cluster and edge labels. Those go through ``| dot_string``, which adds
  the surrounding quotes *and* the backslash escapes and returns Markup so
  autoescape leaves it alone. Forgetting the filter is a loud failure rather
  than a quiet hole: the quotes go missing and Graphviz rejects the file.

  A URL is percent-encoded before it ever gets here
  (``netviz.render.links``), which is a different job from quoting it: the
  encoding keeps the *URL* well formed, ``dot_string`` keeps the *document*
  well formed, and both are needed.

  So: inside <TABLE> use ``{{ value }}``; everywhere else use
  ``{{ value | dot_string }}``. Never the other way round.

  The one HTML *attribute* that carries a variable is ``<IMG SRC>``, and what
  goes in it is never free-form: an icon file is named ``<kind>.<extension>``
  for a kind from a closed set, and the directory it lives in is kept out of
  the label entirely, in the ``imagepath`` graph attribute, where it is a DOT
  string like any other. A legend swatch's ``BGCOLOR`` is the second, and it
  is the same sort of value: a hex colour that
  ``netviz.render.annotations`` has re-checked against ``#rgb``/``#rrggbb``
  on the way through, whatever the schema already promised.

  The one interpolation that is *deliberately* not escaped is a note's
  ``line.html``: the emphasis of §21.1 is markup (``<B>``, ``<I>``, ``<FONT>``)
  wrapped around text that must not be, which is a distinction autoescaping
  cannot make for a single value, so ``netviz.render.dot._note_markup``
  escapes the text itself and hands back Markup.
-#}
{% macro node_block(node, pad) %}
{{ pad }}{{ node.id | dot_string }} [{% if node.element_id %}id={{ node.element_id | dot_string }}, {% endif %}shape={{ node.shape }}, fillcolor="{{ node.fill }}", color="{{ node.stroke }}"{% if node.style is not none %}, style="{{ node.style }}"{% endif %}{% if node.pos %}, pos={{ node.pos | dot_string }}{% endif %}{% if node.penwidth %}, penwidth={{ node.penwidth }}{% endif %}{% if node.fontcolor %}, fontcolor="{{ node.fontcolor }}"{% endif %}{% if node.fontsize %}, fontsize={{ node.fontsize }}{% endif %}{% if node.tooltip %}, tooltip={{ node.tooltip | dot_string }}{% endif %}{% if node.url %}, URL={{ node.url | dot_string }}{% endif %}, label=<
{{ pad }}  <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
{% if node.image %}
{{ pad }}    <TR><TD COLSPAN="3" FIXEDSIZE="TRUE" WIDTH="{{ icon_width }}" HEIGHT="{{ icon_height }}"><IMG SCALE="TRUE" SRC="{{ node.image }}"/></TD></TR>
{% endif %}
{{ pad }}    <TR><TD COLSPAN="3" ALIGN="CENTER"><B>{{ node.title }}</B></TD></TR>
{{ pad }}    <TR><TD COLSPAN="3" ALIGN="CENTER">{{ node.subtitle }}</TD></TR>
{% for row in node.rows %}
{% if row.spans %}
{{ pad }}    <TR><TD COLSPAN="3" ALIGN="CENTER">{{ row.port }}</TD></TR>
{% else %}
{{ pad }}    <TR><TD ALIGN="LEFT">{{ row.port }}</TD><TD ALIGN="LEFT">{{ row.addresses }}</TD><TD ALIGN="LEFT">{{ row.vlans }}</TD></TR>
{% endif %}
{% endfor %}
{{ pad }}  </TABLE>
{{ pad }}>];
{%- endmacro %}
graph netviz {
  graph [
    rankdir={{ rankdir }},
    splines={{ splines }},
    overlap=false,
    nodesep=0.5,
    ranksep=0.7,
    fontname="Helvetica,Arial,sans-serif",
    fontsize=12,
{% if inputscale %}
    inputscale={{ inputscale }},
{% endif %}
{% if background %}
    _background={{ background | dot_string }},
{% endif %}
{% if imagepath %}
    imagepath={{ imagepath | dot_string }},
{% endif %}
{% if title %}
    label={{ title | dot_string }},
    labelloc=t,
    fontsize=16,
{% endif %}
  ];
  node [fontname="Helvetica,Arial,sans-serif", fontsize=10, style=filled, penwidth=1.2];
  edge [fontname="Helvetica,Arial,sans-serif", fontsize=8];
{% if frames %}

{% for frame in frames %}
  {{ frame.id | dot_string }} [shape=plaintext, style="", fillcolor="none", fontcolor="{{ frame.color }}", fontsize={{ frame_font_size }}, margin=0, pos={{ frame.caption | dot_string }}, label={{ frame.label | dot_string }}];
{% endfor %}
{% endif %}
{% for area in areas %}

  subgraph {{ area.id }} {
{% if area.element_id %}
    id={{ area.element_id | dot_string }};
{% endif %}
    label={{ area.label | dot_string }};
    style="{{ area.style }}";
    color="{{ area.stroke }}";
    fillcolor="{{ area.fill }}";
    fontcolor="{{ area.stroke }}";
    fontsize={{ frame_font_size }};
{% if area.penwidth %}
    penwidth={{ area.penwidth }};
{% endif %}
    labeljust=l;
    margin=12;
{% for node in area.nodes %}
{{ node_block(node, "    ") }}
{% endfor %}
  }
{% endfor %}
{% for group in groups %}

{% if group.id %}
  subgraph {{ group.id }} {
{% if group.element_id %}
    id={{ group.element_id | dot_string }};
{% endif %}
    label={{ group.label | dot_string }};
{% if group.tooltip %}
    tooltip={{ group.tooltip | dot_string }};
{% endif %}
    style=rounded;
    color="#9ca3af";
    fontcolor="#4b5563";
    fontsize=11;
    labeljust=l;
    margin=12;
{% for node in group.nodes %}
{{ node_block(node, "    ") }}
{% endfor %}
  }
{% else %}
{% for node in group.nodes %}
{{ node_block(node, "  ") }}
{% endfor %}
{% endif %}
{% endfor %}
{% if notes %}

{% for note in notes %}
  {{ note.id | dot_string }} [{% if note.element_id %}id={{ note.element_id | dot_string }}, {% endif %}shape=note, style=filled, fillcolor="{{ note.fill }}", color="{{ note.stroke }}"{% if note.pos %}, pos={{ note.pos | dot_string }}{% endif %}, label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">
{% for line in note.lines %}
    <TR><TD ALIGN="LEFT" BALIGN="LEFT">{% if line.bullet %}&#8226; {% endif %}{{ line.html }}</TD></TR>
{% endfor %}
    </TABLE>
  >];
{% endfor %}
{% endif %}
{% for legend in legends %}

  subgraph {{ legend.id }} {
{% if legend.element_id %}
    id={{ legend.element_id | dot_string }};
{% endif %}
    style=rounded;
    color="{{ legend.stroke }}";
    fontcolor="{{ legend.stroke }}";
    fontsize={{ frame_font_size }};
    labeljust=l;
    margin=8;
    {{ legend.node | dot_string }} [shape=plaintext, style="", fillcolor="none"{% if legend.pos %}, pos={{ legend.pos | dot_string }}{% endif %}, label=<
      <TABLE BORDER="{{ legend.border }}" COLOR="{{ legend.stroke }}" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="{{ legend.fill }}">
{% if legend.title %}
      <TR><TD COLSPAN="2" ALIGN="LEFT"><B>{{ legend.title }}</B></TD></TR>
{% endif %}
{% for row in legend.rows %}
      <TR><TD FIXEDSIZE="TRUE" WIDTH="20" HEIGHT="{{ row.height }}" BGCOLOR="{{ row.color }}"></TD><TD ALIGN="LEFT">{{ row.label }}{% if row.description %} — {{ row.description }}{% endif %}</TD></TR>
{% endfor %}
      </TABLE>
    >];
  }
{% endfor %}
{% if edges %}

{% for edge in edges %}
  {{ edge.source | dot_string }} -- {{ edge.target | dot_string }} [{% if edge.element_id %}id={{ edge.element_id | dot_string }}, {% endif %}color="{{ edge.color }}", style={{ edge.style }}{% if edge.penwidth %}, penwidth={{ edge.penwidth }}{% endif %}{% if edge.weight %}, weight={{ edge.weight }}{% endif %}{% if edge.pos %}, pos={{ edge.pos | dot_string }}{% endif %}{% if edge.lp %}, lp={{ edge.lp | dot_string }}{% endif %}{% if edge.fontcolor %}, fontcolor="{{ edge.fontcolor }}"{% endif %}{% if edge.fontsize %}, fontsize={{ edge.fontsize }}{% endif %}{% if edge.label %}, label={{ edge.label | dot_string }}{% endif %}{% if edge.xlabel %}, xlabel={{ edge.xlabel | dot_string }}{% endif %}{% if edge.tooltip %}, tooltip={{ edge.tooltip | dot_string }}{% endif %}{% if edge.url %}, URL={{ edge.url | dot_string }}{% endif %}{% if edge.arrowhead %}, arrowhead={{ edge.arrowhead }}{% endif %}{% if edge.constraint %}, constraint={{ edge.constraint }}{% endif %}];
{% endfor %}
{% endif %}
}
