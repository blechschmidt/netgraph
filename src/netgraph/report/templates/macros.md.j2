{# Markdown building blocks. Every page is these five macros over the model.

   Values that came out of the inventory go through the ``cell`` filter inside a
   table and the ``md`` filter outside one; a whole table row is
   ``row | map("mdcell", link) | join(" | ")``, which keeps the line breaks a
   Markdown table depends on out of Jinja's block-trimming rules. See
   netgraph.report.write.

   Anchors are written as explicit <a id="..."> elements rather than left to
   whatever a renderer derives from a heading, because a report's own
   cross-references cannot depend on that. A table's anchor is prefixed so it
   cannot collide with the anchor of the section holding it. #}

{% macro table(entry, link) %}
<a id="table-{{ entry.key }}"></a>

**{{ entry.title | md }}**

{% if entry.rows %}
| {{ entry.columns | map(attribute="header") | map("cell") | join(" | ") }} |
|{{ entry.columns | map("mdalign") | join("|") }}|
{% for row in entry.rows %}
| {{ row | map("mdcell", link) | join(" | ") }} |
{% endfor %}
{% else %}
_{{ entry.empty | md }}_
{% endif %}
{% if entry.note %}

{{ entry.note | md }}
{% endif %}
{% endmacro %}

{% macro fields(entries, link) %}
| Field | Value |
|:---|:---|
{% for entry in entries %}
| {{ entry.label | cell }} | {{ entry.value | mdcell(link) }} |
{% endfor %}
{% endmacro %}

{% macro diagram(entry, link) %}
**{{ entry.title | md }}** — {{ entry.nodes }} node(s), {{ entry.edges }} link(s)

{% if entry.path %}
![{{ entry.title | md }} ({{ entry.layer }})]({{ link(entry.path) }})
{% else %}
_{{ entry.note | md }}_
{% endif %}
{% endmacro %}

{% macro section(entry, link) %}
<a id="{{ entry.key }}"></a>

## {{ entry.title | md }}

{% if entry.blurb %}
{{ entry.blurb | md }}

{% endif %}
{% if entry.fields %}
{{ fields(entry.fields, link) }}
{% endif %}
{% for item in entry.diagrams %}
{{ diagram(item, link) }}
{% endfor %}
{% for item in entry.tables %}
{{ table(item, link) }}
{% endfor %}
{% if entry.links %}
{% for reference in entry.links %}
- {{ reference | mdcell(link) }}
{% endfor %}

{% endif %}
{% for note in entry.notes %}
{{ note | md }}

{% endfor %}
{% endmacro %}

{% macro provenance(meta) %}
| Fact | Value |
|:---|:---|
| Inventory | `{{ meta.inventory | cell }}` |
| Scope | {{ meta.scope | cell }} |
| Generated | {{ meta.generated_at | cell if meta.generated_at else "not stamped" }} |
| netgraph | {{ meta.version | cell }} |
| Inventory revision | {{ (meta.revision ~ " (" ~ meta.revision_state ~ ")") | cell if meta.revision else "not under version control" }} |
{% endmacro %}
