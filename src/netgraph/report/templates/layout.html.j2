{# The frame every HTML page shares: one inlined style sheet, its own strict
   Content-Security-Policy, and nothing to fetch. A page opened from a file://
   URL, served from a subdirectory or mailed as a zip behaves the same way. #}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="{{ csp }}">
<meta name="generator" content="netgraph {{ meta.version }}">
<title>{{ page.title }} — {{ meta.title }}</title>
<link rel="icon" href="data:,">
<style>{{ style }}</style>
</head>
<body>
<header class="page">
{% block breadcrumb %}{% endblock %}
<h1>{{ page.title }}</h1>
{% if page.summary %}
<p class="summary">{{ page.summary }}</p>
{% endif %}
</header>
<main>
{% block body %}{% endblock %}
</main>
<footer>
netgraph {{ meta.version }}{% if meta.generated_at %}, generated {{ meta.generated_at }}{% endif %}{% if meta.revision %}, inventory revision <code>{{ meta.revision }}</code> ({{ meta.revision_state }}){% endif %}.
</footer>
</body>
</html>
